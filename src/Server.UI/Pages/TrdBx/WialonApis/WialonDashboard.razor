@page "/wialon/session-manager"

@using CleanArchitecture.Blazor.Application.Common.Interfaces
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.WialonUnits.Caching
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.WialonUnits.Commands.Delete
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.WialonUnits.Commands.Import
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.WialonUnits.Commands.Syncs
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.WialonUnits.DTOs
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.WialonUnits.Queries.Export
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.WialonUnits.Queries.Pagination
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.WialonUnits.Specifications

@using CleanArchitecture.Blazor.Application.Features.WialonApis.Commands.Login
@using CleanArchitecture.Blazor.Application.Features.WialonApis.Commands.Logout
@using CleanArchitecture.Blazor.Application.Features.WialonApis.Commands.CheckSession
@using CleanArchitecture.Blazor.Application.Features.WialonApis.Commands.RetrieveToken
@using MediatR

@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>Wialon Session Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4"> <MudText Typo="Typo.h3" GutterBottom="true"> <MudIcon Icon="@Icons.Material.Filled.SatelliteAlt" Class="mr-2" /> Wialon Session Management </MudText>

<!-- Session Status Card -->
<MudCard Elevation="3" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">
                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                Session Status
            </MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudChip T="string" Color="sessionStatusColor" 
                     Size="Size.Small" 
                     Variant="Variant.Filled"
                     Icon="@sessionStatusIcon">
                @sessionStatusText
            </MudChip>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Session ID</MudText>
                <MudText Typo="Typo.body1" Class="font-monospace">@sessionId</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Status</MudText>
                <MudText Typo="Typo.body1">
                    <MudBadge Color="sessionStatusColor" 
                              Dot="true" 
                              Origin="Origin.CenterLeft">
                        <span class="ml-4">@sessionStatusText</span>
                    </MudBadge>
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Last Activity</MudText>
                <MudText Typo="Typo.body1">
                    <MudIcon Icon="@Icons.Material.Filled.AccessTime" 
                             Size="Size.Small" 
                             Class="mr-1" />
                    @lastActivity
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Auto-Reconnect</MudText>
                <MudSwitch T="bool" @bind-Checked="autoReconnect" 
                           Disabled="true" 
                           Color="Color.Success" />
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

<!-- Session Controls -->
<MudCard Elevation="3" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">
                <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
                Session Controls
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudStack Row="true" Spacing="2" Justify="Justify.FlexStart">
            <MudLoadingButton Variant="Variant.Filled" 
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Login"
                       OnClick="LoginAsync"
                       Disabled="@isLoading"
                       Loading="@isLoggingIn">
                Login
            </MudLoadingButton>
            
            <MudLoadingButton Variant="Variant.Filled" 
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Logout"
                       OnClick="LogoutAsync"
                       Loading="@isLoading"
                       Disabled="@(isLoading || !isSessionActive)">
                Logout
            </MudLoadingButton>
            
            <MudLoadingButton Variant="Variant.Outlined" 
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.CheckCircle"
                       OnClick="CheckSessionAsync"
                       Disabled="@isLoading"
                       Loading="@isLoading">
                Check Session
            </MudLoadingButton>

            <MudLoadingButton Variant="Variant.Filled" 
                       Color="Color.Tertiary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ReconnectAsync"
                       Disabled="@isLoading"
                       Loading="@isLoading">
                Reconnect
            </MudLoadingButton>

            <MudLoadingButton Variant="Variant.Outlined" 
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.VpnKey"
                       OnClick="() => showRetrieveDialog = true"
                       Disabled="@isLoading"
                       Loading="@isLoading">
                Retrieve Token
            </MudLoadingButton>
        </MudStack>
    </MudCardContent>
</MudCard>

<!-- API Operations -->
<MudCard Elevation="3" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">
                <MudIcon Icon="@Icons.Material.Filled.Api" Class="mr-2" />
                API Operations
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>

    </MudCardContent>
</MudCard>

<!-- Event Log -->
<MudCard Elevation="3" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">
                <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
                Event Log
            </MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" 
                           OnClick="ClearLog"
                           Disabled="@(!eventLog.Any())" />
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudPaper Height="300px" Class="overflow-y-auto pa-3" Elevation="0">
            @if (eventLog.Any())
            {
         @*        <MudList>
                    @foreach (var logEntry in eventLog.TakeLast(50))
                    {
                        <MudListItem Icon="@GetLogIcon(logEntry.Type)"
                                     Text="@logEntry.Message"
                                     SecondaryText="@logEntry.Timestamp.ToString(\"HH:mm:ss\")"
                                     Disabled="true">
                            <ChildContent>
                                <MudChip Size="Size.Small" 
                                         Color="@GetLogChipColor(logEntry.Type)"
                                         Variant="Variant.Text"
                                         Class="ml-2">
                                    @logEntry.Type
                                </MudChip>
                            </ChildContent>
                        </MudListItem>
                    }
                </MudList> *@
            }
            else
            {
                <MudText Typo="Typo.body2" 
                         Color="Color.Default" 
                         Align="Align.Center" 
                         Class="mt-8">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" Class="mb-2" />
                    <br />
                    No events logged yet
                </MudText>
            }
        </MudPaper>
    </MudCardContent>
</MudCard>

<!-- Connection Details Dialog -->
<MudDialog @bind-Visible="showDetailsDialog">
    <DialogContent>
        <MudDialogTitle>
            <MudText Typo="Typo.h6">Connection Details</MudText>
        </MudDialogTitle>
        <MudText>
            <strong>Base URL:</strong> @config.BaseUrl<br />
            <strong>Keep-Alive Interval:</strong> @config.KeepAliveIntervalMinutes minutes<br />
            <strong>Session Timeout:</strong> @config.SessionTimeoutMinutes minutes<br />
            <strong>Auto-Reconnect:</strong> @(config.AutoReconnect ? "Enabled" : "Disabled")<br />
            <strong>Max Retries:</strong> @config.MaxRetryAttempts attempts
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => showDetailsDialog = false">Close</MudButton>
    </DialogActions>
</MudDialog>

<!-- Retrieve Token Dialog -->
<MudDialog @bind-Visible="showRetrieveDialog">
    <DialogContent>
        <MudDialogTitle>
            <MudText Typo="Typo.h6">Retrieve Wialon Token</MudText>
        </MudDialogTitle>

        <MudTextField @bind-Value="retrieveUsername" Label="Username" Variant="Variant.Outlined" />
        <MudTextField @bind-Value="retrievePassword" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined" />

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
            The password will be submitted to the CMS login endpoint to retrieve an access token. Only provide credentials you trust.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => showRetrieveDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetrieveTokenAsync" Disabled="@isRetrievingToken" Loading="@isRetrievingToken">Retrieve</MudButton>
    </DialogActions>
</MudDialog>

</MudContainer>

@code {
// Session state
private string sessionStatusText = "Disconnected";
private string sessionId = "N/A";
private string lastActivity = "N/A";
private bool isSessionActive;
private bool autoReconnect = true;

// Loading states
private bool isLoading;
private bool isLoggingIn;

// Dialogs
private bool showDetailsDialog;

// Retrieve token dialog
private bool showRetrieveDialog;
private string retrieveUsername = "WialonTest";
private string retrievePassword = string.Empty;
private bool isRetrievingToken;

// Event log
private List<LogEntry> eventLog = new();

// Config (injected)
[Inject] private IConfiguration Configuration { get; set; }
[Inject] private IWialonService SessionService { get; set; } = default!;
private WialonSessionConfig config = new();

// Computed properties for UI
private Color sessionStatusColor => isSessionActive ? Color.Success : Color.Error;
private string sessionStatusIcon => isSessionActive ? 
    Icons.Material.Filled.CheckCircle : 
    Icons.Material.Filled.Error;

protected override async Task OnInitializedAsync()
{
    // Load config
    Configuration.GetSection("Wialon").Bind(config);
    
    // Subscribe to session events
    SessionService.SessionStatusChanged += HandleSessionStatusChanged;
    SessionService.SessionExpired += HandleSessionExpired;
    SessionService.TokenExpiring += HandleTokenExpiring;
    
    await CheckSessionAsync();
}

private async Task LoginAsync()
{
    isLoggingIn = true;
    isLoading = true;
    
    try
    {
        AddLogEntry("info", "Attempting to login to Wialon...");
        
        var loginResult = await Mediator.Send(new LoginAsyncCommand());

        if (loginResult != null && loginResult.Success)
        {
            Snackbar.Add($"Login successful! Session: {loginResult.SessionId?[..8]}...", Severity.Success);
            AddLogEntry("success", $"Login successful. User: {loginResult.User?.Name ?? "Unknown"}");
            UpdateSessionInfo(loginResult.SessionId);
            isSessionActive = true;
        }
        else
        {
            var err = loginResult?.ErrorMessage ?? "Login failed";
            Snackbar.Add($"Login failed: {err}", Severity.Error);
            AddLogEntry("error", $"Login failed: {err}");
        }
    }
    catch (Exception ex)
    {
        Snackbar.Add($"Login error: {ex.Message}", Severity.Error);
        AddLogEntry("error", $"Login error: {ex.Message}");
    }
    finally
    {
        isLoggingIn = false;
        isLoading = false;
    }
}

private async Task LogoutAsync()
{
    isLoading = true;
    
    try
    {
        AddLogEntry("info", "Logging out from Wialon...");
        
        var success = await Mediator.Send(new LogoutAsyncCommand());
        
        if (success)
        {
            Snackbar.Add("Logged out successfully", Severity.Info);
            AddLogEntry("success", "Logged out successfully");
            ClearSessionInfo();
        }
        else
        {
            Snackbar.Add("Logout failed", Severity.Error);
            AddLogEntry("error", "Logout failed");
        }
    }
    catch (Exception ex)
    {
        Snackbar.Add($"Logout error: {ex.Message}", Severity.Error);
        AddLogEntry("error", $"Logout error: {ex.Message}");
    }
    finally
    {
        isLoading = false;
    }
}

private async Task CheckSessionAsync()
{
    isLoading = true;
    
    try
    {
        var isValid = await SessionService.IsSessionValidAsync();
        isSessionActive = isValid;
        sessionStatusText = isValid ? "Active" : "Inactive";
        
        if (isValid)
        {
            var sid = await SessionService.GetSessionIdAsync();
            UpdateSessionInfo(sid);
            AddLogEntry("info", "Session is valid");
        }
        else
        {
            AddLogEntry("warning", "Session is inactive or expired");
        }
    }
    catch (Exception ex)
    {
        AddLogEntry("error", $"Session check failed: {ex.Message}");
    }
    finally
    {
        isLoading = false;
    }
}

private async Task ReconnectAsync()
{
    isLoading = true;
    
    try
    {
        AddLogEntry("info", "Attempting to reconnect...");
        
        var success = await SessionService.EnsureSessionAsync();
        
        if (success)
        {
            Snackbar.Add("Reconnected successfully", Severity.Success);
            AddLogEntry("success", "Reconnection successful");
            await CheckSessionAsync();
        }
        else
        {
            Snackbar.Add("Reconnection failed", Severity.Error);
            AddLogEntry("error", "Reconnection failed");
        }
    }
    catch (Exception ex)
    {
        Snackbar.Add($"Reconnection error: {ex.Message}", Severity.Error);
        AddLogEntry("error", $"Reconnection error: {ex.Message}");
    }
    finally
    {
        isLoading = false;
    }
}

private async Task RetrieveTokenAsync()
{
    showRetrieveDialog = false;
    isRetrievingToken = true;
    isLoading = true;

    try
    {
        AddLogEntry("info", "Retrieving token from CMS login endpoint...");
        var result = await Mediator.Send(new RetrieveTokenCommand { Username = retrieveUsername, Password = retrievePassword });

        if (result != null && result.Succeeded)
        {
            Snackbar.Add("Token retrieved and updated successfully", Severity.Success);
            AddLogEntry("success", "Token retrieved and updated successfully");
            await CheckSessionAsync();
        }
        else
        {
            var err = result?.ErrorMessage ?? "Token retrieval failed";
            Snackbar.Add($"Token retrieval failed: {err}", Severity.Error);
            AddLogEntry("error", $"Token retrieval failed: {err}");
        }
    }
    catch (Exception ex)
    {
        Snackbar.Add($"Token retrieval error: {ex.Message}", Severity.Error);
        AddLogEntry("error", $"Token retrieval error: {ex.Message}");
    }
    finally
    {
        isRetrievingToken = false;
        isLoading = false;
        // Clear password for safety
        retrievePassword = string.Empty;
    }
}

private void HandleSessionStatusChanged(object? sender, WialonSessionEventArgs e)
{
    InvokeAsync(() =>
    {
        isSessionActive = e.IsActive;
        sessionStatusText = e.IsActive ? "Active" : "Inactive";
        UpdateSessionInfo(e.SessionId);
        
        AddLogEntry(e.IsActive ? "success" : "warning", 
            $"Session status changed: {e.Message}");
    });
}

private void HandleSessionExpired(object? sender, WialonSessionEventArgs e)
{
    InvokeAsync(() =>
    {
        Snackbar.Add($"Session expired: {e.Message}", Severity.Warning, 
            config => { config.Action = "Reconnect"; });
        
        AddLogEntry("warning", $"Session expired: {e.Message}");
        ClearSessionInfo();
    });
}

private void HandleTokenExpiring(object? sender, WialonSessionEventArgs e)
{
    InvokeAsync(() =>
    {
        Snackbar.Add($"Token expiring: {e.Message}", Severity.Warning);
        AddLogEntry("warning", $"Token expiring: {e.Message}");
    });
}

private void UpdateSessionInfo(string? sid)
{
    sessionId = sid ?? "N/A";
    lastActivity = DateTime.Now.ToString("HH:mm:ss");
    StateHasChanged();
}

private void ClearSessionInfo()
{
    isSessionActive = false;
    sessionStatusText = "Disconnected";
    sessionId = "N/A";
    lastActivity = "N/A";
    StateHasChanged();
}

private void AddLogEntry(string type, string message)
{
    eventLog.Add(new LogEntry
    {
        Type = type,
        Message = message,
        Timestamp = DateTime.Now
    });
    StateHasChanged();
}

private void ClearLog()
{
    eventLog.Clear();
    StateHasChanged();
}

private string GetLogIcon(string type) => type switch
{
    "success" => Icons.Material.Filled.CheckCircle,
    "error" => Icons.Material.Filled.Error,
    "warning" => Icons.Material.Filled.Warning,
    "info" => Icons.Material.Filled.Info,
    _ => Icons.Material.Filled.Circle
};

private Color GetLogChipColor(string type) => type switch
{
    "success" => Color.Success,
    "error" => Color.Error,
    "warning" => Color.Warning,
    "info" => Color.Info,
    _ => Color.Default
};

public void Dispose()
{
    SessionService.SessionStatusChanged -= HandleSessionStatusChanged;
    SessionService.SessionExpired -= HandleSessionExpired;
    SessionService.TokenExpiring -= HandleTokenExpiring;
}

private class LogEntry
{
    public string Type { get; set; } = "info";
    public string Message { get; set; } = string.Empty;
    public DateTime Timestamp { get; set; } = DateTime.Now;
}
}