@page "/pages/TrdBx/TrackedAssets"

@using CleanArchitecture.Blazor.Application.Features.TrackedAssets.Caching
@using CleanArchitecture.Blazor.Application.Features.TrackedAssets.Commands.Create
@using CleanArchitecture.Blazor.Application.Features.TrackedAssets.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.TrackedAssets.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.TrackedAssets.Commands.Update
@using CleanArchitecture.Blazor.Application.Features.TrackedAssets.DTOs
@using CleanArchitecture.Blazor.Application.Features.TrackedAssets.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.TrackedAssets.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.TrackedAssets.Specifications
@using CleanArchitecture.Blazor.Server.UI.Pages.TrdBx.TrackedAssets.Components

@inject IStringLocalizer<TrackedAssets> L
@inject BlazorDownloadFileService BlazorDownloadFileService
@attribute [Authorize(Policy = Permissions.TrackedAssets.View)]


<PageTitle>@Title</PageTitle>

<MudDataGrid ServerData="@(ServerReload)"
             FixedHeader="true"
             FixedFooter="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             ColumnResizeMode="ResizeMode.Column"
             MultiSelection="true"
             T="TrackedAssetDto"
             SelectOnRowClick="false"
             RowClick="@(s=>OnView(s.Item))"
             @bind-SelectedItems="_selectedItems"
             Hover="true" @ref="_table">

    <ToolBarContent>
        <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">

            <MudStack Row AlignItems="AlignItems.Start">
                <MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudEnumSelect Style="min-width:120px" TEnum="TrackedAssetListView" ValueChanged="OnChangedListView" Value="Query.ListView" Dense="true" Label="@AppStrings.ListView"></MudEnumSelect>
                </MudStack>
            </MudStack>

            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudToolBar Dense WrapContent="true" Class="py-1 px-0">

                    <MudButton Disabled="@_loading"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @AppStrings.Refresh
                    </MudButton>

                    @if (_accessRights.Create)
                    {
                        <MudButton StartIcon="@Icons.Material.Outlined.Add"
                                   OnClick="OnCreate">
                            @AppStrings.New
                        </MudButton>
                    }

                    @if (_accessRights.Import)
                    {
                        <MudFileUpload T="IBrowserFile" FilesChanged="OnImportData" Accept=".xlsx">
                            <CustomContent>
                                <MudLoadingButton Class="pa-0 ma-0" Style="font-weight:400;text-transform:none;"
                                                  Variant="Variant.Text"
                                                  Loading="@_uploading">
                                    @AppStrings.Import
                                </MudLoadingButton>
                            </CustomContent>
                        </MudFileUpload>
                    }
                    @if (_accessRights.Export)
                    {
                        <MudButton Disabled="@(!(_selectedItems.Count > 0))"
                                   OnClick="OnExport">
                            @AppStrings.Export

                        </MudButton>
                    }

                    <MudMenu TransformOrigin="Origin.BottomRight" AnchorOrigin="Origin.BottomRight" EndIcon="@Icons.Material.Filled.MoreVert" Label="@AppStrings.More">

                        @if (_accessRights.Delete)
                        {
                            <MudMenuItem Disabled="@(!(_selectedItems.Count > 0))"
                                         OnClick="OnDeleteChecked">
                                @AppStrings.Delete
                            </MudMenuItem>
                        }
                    </MudMenu>

                </MudToolBar>

                <MudStack Row Spacing="1">
            @*         @if (_accessRights.Search)
                    { *@
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@Query.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
                        </MudTextField>
                    @* } *@

                </MudStack>

            </MudStack>

        </MudStack>


    </ToolBarContent>

    <Columns>
        <SelectColumn ShowInFooter="false"></SelectColumn>
        <TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Actions" Sortable="false">
            <CellTemplate>
                <MudStack Spacing="2" Row="true" Justify="Justify.FlexStart">
                    <MudIconButton Variant="Variant.Outlined"
                                   OnClick="@(()=>OnEdit(context.Item))"
                                   Disabled="(!_accessRights.Edit)"
                                   Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Primary">
                    </MudIconButton>

                    <MudIconButton Variant="Variant.Outlined"
                                   OnClick="@(()=>OnViewTrackingUnit(context.Item))"
                                   Disabled="(context.Item.TrackingUnits is null && (!_accessRights.View))"
                                   Icon="@Icons.Material.Filled.Preview"
                                   Size="Size.Small"
                                   Color="Color.Primary">
                    </MudIconButton>
                </MudStack>
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.TrackedAssetNo" Title="@L[_currentDto.GetMemberDisplayName(x => x.TrackedAssetNo)]" />
        <PropertyColumn Property="x => x.TrackedAssetCode" Title="@L[_currentDto.GetMemberDisplayName(x => x.TrackedAssetCode)]" />
        <PropertyColumn Property="x => x.VinSerNo" Title="@L[_currentDto.GetMemberDisplayName(x => x.VinSerNo)]" />
        <PropertyColumn Property="x => x.PlateNo" Title="@L[_currentDto.GetMemberDisplayName(x => x.PlateNo)]" />
        <PropertyColumn Property="x => x.TrackedAssetDesc" Title="@L[_currentDto.GetMemberDisplayName(x => x.TrackedAssetDesc)]" />
        <PropertyColumn Property="x => x.OldVehicleNo" Title="@L[_currentDto.GetMemberDisplayName(x => x.OldVehicleNo)]" />
        <PropertyColumn Property="x => x.IsAvaliable" Title="@L[_currentDto.GetMemberDisplayName(x => x.IsAvaliable)]" />

    </Columns>
    <NoRecordsContent>
        <MudText>@AppStrings.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@AppStrings.Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager PageSizeOptions="@(new int[]{10,15,30,50,100})" />
    </PagerContent>
</MudDataGrid>



@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private UserProfile UserProfile => UserProfileState.Value;
    private TrackedAssetsAccessRights _accessRights = new();
    public string? Title { get; private set; }
    private HashSet<TrackedAssetDto> _selectedItems = new();
    private MudDataGrid<TrackedAssetDto> _table = default!;
    private TrackedAssetDto _currentDto = new();
    // private TrackedAssetsAccessRights _accessRights = new();
    private int _defaultPageSize = 15;
    private bool _loading;
    private bool _uploading;
    private bool _exporting;

   private TrackedAssetsWithPaginationQuery Query { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Title =L[_currentDto.GetClassDescription()];
        _accessRights = await PermissionService.GetAccessRightsAsync<TrackedAssetsAccessRights>();
    }


    private async Task<GridData<TrackedAssetDto>> ServerReload(GridState<TrackedAssetDto> state, CancellationToken cancellationToken)
    {
        try
        {
            _loading = true;
            Query.OrderBy = state.SortDefinitions.FirstOrDefault()?.SortBy ?? "Id";
            Query.SortDirection = state.SortDefinitions.FirstOrDefault()?.Descending ?? true
                                              ? SortDirection.Descending.ToString()
                                              : SortDirection.Ascending.ToString();
            Query.PageNumber = state.Page + 1;
            Query.PageSize = state.PageSize;
            var result = await Mediator.Send(Query).ConfigureAwait(false);
            return new GridData<TrackedAssetDto> { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }
    }

  private async Task OnRefresh()
    {
        await AppCache.RemoveByTagsAsync(TrackedAssetCacheKey.Tags);
        _selectedItems = new HashSet<TrackedAssetDto>();
        Query.Keyword  = string.Empty;
        await _table.ReloadServerData();
    }
    private async Task OnSearch(string text)
    {
        _selectedItems = new HashSet<TrackedAssetDto>();
        Query.Keyword = text;
        await _table.ReloadServerData();
    }

    private async Task OnChangedListView(TrackedAssetListView listview)
    {
        Query.ListView = listview;
        await _table.ReloadServerData();
    }


 

    private Task OnView(TrackedAssetDto dto)
    {
        Navigation.NavigateTo($"/pages/TrdBx/TrackedAssets/{dto.Id}/view?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
        return Task.CompletedTask;
    }


    async Task OnViewTrackingUnit(TrackedAssetDto dto)
    {
        if (!(dto.TrackingUnits is null))
        {
            var id = dto.TrackingUnits.FirstOrDefault().Id;
            Navigation.NavigateTo($"/pages/TrdBx/TrackingUnits/{id}/view?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
        }
    }

    #region Curd

    private Task OnCreate()
    {
        var command = new CreateTrackedAssetCommand();
  
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        return DialogServiceHelper.ShowDialogAsync<TrackedAssetCreateFormDialog>(
            L["Create TrackedAsset"],
            async _ =>
            {
                await _table.ReloadServerData();
                 _selectedItems.Clear();
            },
			p =>
			{
				p.Add(x => x._model, command);
			},
			options);

    }
    private Task OnEdit(TrackedAssetDto dto)
    {
        var command = ObjectMapper.Map<UpdateTrackedAssetCommand>(dto);
  
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        return DialogServiceHelper.ShowDialogAsync<TrackedAssetEditFormDialog>(
            L["Update TrackedAsset"],
            async _ =>
            {
                await _table.ReloadServerData();
                 _selectedItems.Clear();
            },
			p =>
			{
				p.Add(x => x._model, command);
			},
			options);
    }
    private Task OnDelete(TrackedAssetDto dto)
    {
        var contentText = string.Format(AppStrings.DeleteConfirmationWithId, dto.Id);
        var command = new DeleteTrackedAssetCommand(new int[] { dto.Id });
          return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
            command,
            AppStrings.DeleteConfirmationTitle,
            contentText,
            async () =>
            {
                 await _table.ReloadServerData();
                _selectedItems.Clear();
            });
    }
    private Task OnDeleteChecked()
    {
        var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedItems.Count);
        var command = new DeleteTrackedAssetCommand(_selectedItems.Select(x => x.Id).ToArray());
        return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
            command, 
            AppStrings.DeleteConfirmationTitle, 
            contentText, 
            async () =>
        {
            await InvokeAsync(async () =>
            {
                await _table.ReloadServerData();
                _selectedItems.Clear();
            });
        });
    }

    private async Task OnExport()
    {
        _exporting = true;
        try
		{
            var request = new ExportTrackedAssetsQuery()
                {
                    Keyword = Query.Keyword,
                    ListView = Query.ListView,
                    OrderBy = _table.SortDefinitions.Values.FirstOrDefault()?.SortBy ?? "Id",
                    SortDirection = (_table.SortDefinitions.Values.FirstOrDefault()?.Descending ?? true) ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString()
                };
            var result = await Mediator.Send(request);
            await result.MatchAsync(
            async data =>
            {
                await BlazorDownloadFileService.DownloadFileAsync($"{L["TrackedAssets"]}.xlsx", data, contentType:"application/octet-stream");
                Snackbar.Add($"{AppStrings.ExportSuccess}", MudBlazor.Severity.Info);
            },
            errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        }
		catch (Exception ex)
		{
			Snackbar.Add($"Export failed: {ex.Message}", MudBlazor.Severity.Error);
		}
		finally
		{
			_exporting = false;
		}
    }



    #endregion



    async Task OnImportData(IBrowserFile file)
    {
        _uploading = true;
        var stream = new MemoryStream();
        await file.OpenReadStream().CopyToAsync(stream);
        var command = new ImportTrackedAssetsCommand(file.Name, stream.ToArray());
        var result = await Mediator.Send(command);
        if (result.Succeeded)
        {
            await _table.ReloadServerData();
            Snackbar.Add($"{AppStrings.ImportSuccess}", Severity.Info);
        }
        else
        {
            foreach (var msg in result.Errors)
            {
                Snackbar.Add($"{msg}", Severity.Error);
            }
        }
        _uploading = false;
    }

}
