@using CleanArchitecture.Blazor.Server.UI.Pages.TrdBx.Customers
@using CleanArchitecture.Blazor.Application.Features.Customers.Commands.Create
@using CleanArchitecture.Blazor.Domain.Enums

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<Customers> L
@attribute [Authorize(Policy = Permissions.Customers.Create)]

<MudDialog>
    <DialogContent>
        <MudForm Model="@_command" @ref="@_form" Validation="@(Validator.ValidateValue(_command))">
            <MudGrid>
                <MudItem md="12">
                    <MudTextField Label="@L[_command.GetMemberDisplayName(x => x.Name)]" @bind-Value="_command.Name" For="@(() => _command.Name)" Required="false" RequiredError="@L["Name is required!"]"></MudTextField>
                </MudItem>
                <MudItem md="4">
                    <MudTextField Label="@L[_command.GetMemberDisplayName(x => x.Account)]" @bind-Value="_command.Account" For="@(() => _command.Account)" Required="false" RequiredError="@L["Account is required!"]"></MudTextField>
                </MudItem>

                <MudItem md="4">
                    <MudTextField Label="@L[_command.GetMemberDisplayName(x => x.UserName)]" 
                        @bind-Value="_command.UserName" For="@(() => _command.UserName)" 
                        Required="false" 
                        RequiredError="@L["UserName is required!"]"></MudTextField>
                </MudItem>

                <MudItem md="4">
                    <MudEnumSelect 
                        TEnum="BillingPlan"
                                   ValueChanged="OnChangedBillingPlan"
                                   Value="_command.BillingPlan"
                        Dense="true" 
                        Label="@L["BillingPlan"]"></MudEnumSelect>
                </MudItem>


                <MudItem md="6">
                    <MudCheckBox Label="@L[_command.GetMemberDisplayName(x => x.IsTaxable)]" @bind-Value="_command.IsTaxable" For="@(() => _command.IsTaxable)" />
                </MudItem>
                <MudItem md="6">
                    <MudCheckBox Label="@L[_command.GetMemberDisplayName(x => x.IsRenewable)]" @bind-Value="_command.IsRenewable" For="@(() => _command.IsRenewable)" />
                </MudItem>

            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudLoadingButton Loading="@_savingnew" OnClick="OnSaveAndNew">@AppStrings.SaveAndNew</MudLoadingButton>
        <MudLoadingButton Loading="@_saving" OnClick="OnSave">@AppStrings.Save</MudLoadingButton>
        <MudButton OnClick="Cancel">@AppStrings.Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {

    MudForm _form = new();
    private bool _saving = false;
    private bool _savingnew = false;
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [EditorRequired] [Parameter] public CreateParentCommand _command { get; set; } = null!;

    private Task OnChangedBillingPlan(BillingPlan billingPlan)
    {
        _command.BillingPlan = billingPlan;

        return  Task.CompletedTask;
    }

    async Task OnSave()
    {
           try
        {
            _saving = true;
            await _form.ValidateAsync();
            if (!_form.IsValid)
                return;
            var result = await Mediator.Send(_command);
            result.Match(data =>
            {
                MudDialog.Close(DialogResult.Ok(true));
                Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
            }, errors =>
            {
                Snackbar.Add(errors, MudBlazor.Severity.Error);
            });
        }
        finally
        {
            _saving = false;
        }
    }
    async Task OnSaveAndNew()
    {
         try
        {
            _savingnew = true;
            await _form.ValidateAsync();
            if (!_form.IsValid)
                return;
            var result = await Mediator.Send(_command);
            result.Match(data =>
            { 
                Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);

                 Task.Delay(300);

                 _command = new CreateParentCommand() 
                      { 
                          BillingPlan = _command.BillingPlan,
                          IsTaxable = _command.IsTaxable,
                          IsRenewable = _command.IsRenewable
                      };
            }, errors =>
            {
                Snackbar.Add(errors, MudBlazor.Severity.Error);
            });
        }
        finally
        {
            _savingnew = false;
        }

    }
    void Cancel() => MudDialog.Cancel();
}
