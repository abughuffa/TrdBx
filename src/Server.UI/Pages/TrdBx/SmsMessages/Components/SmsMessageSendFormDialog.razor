@using CleanArchitecture.Blazor.Server.UI.Pages.TrdBx.SmsMessages
@using CleanArchitecture.Blazor.Application.Features.SmsMessages.Commands.SendAndPersist

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<SmsMessages> L
@attribute [Authorize(Policy = Permissions.SmsMessages.Send)]

<MudDialog>
    <DialogContent>
        <MudForm Model="@_model" @ref="@_form" Validation="@(Validator.ValidateValue(_model))">
                            <MudGrid Spacing="2">

                    <MudItem md="9">
                        <MudTextField Label="@L[_model.GetMemberDisplayName(x=>x.To)]" @bind-Value="_model.To" For="@(() => _model.To)" Required="false" RequiredError="@L["PhoneNumber is required!"]"></MudTextField>
                    </MudItem>

                    <MudItem md="9">
                        <MudTextField Label="@L[_model.GetMemberDisplayName(x=>x.SimSlot)]" @bind-Value="_model.SimSlot" For="@(() => _model.SimSlot)" Required="false" RequiredError="@L["SimSlot is required!"]"></MudTextField>
                    </MudItem>

                    <MudItem md="12">
                        <MudTextField 
                                 Label="@L[_model.GetMemberDisplayName(x=>x.Body)]" 
                                 @bind-Value="_model.Body" For="@(() => _model.Body)" 
                                 Required="true" 
                                 RequiredError="@L["Message is required!"]"
                                 Lines="5"
                                 Variant="Variant.Outlined">    
                        </MudTextField>
                    </MudItem>
                    
                </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudLoadingButton Loading="@_savingnew" OnClick="OnSaveAndNew">@AppStrings.SaveAndNew</MudLoadingButton>
        <MudLoadingButton Loading="@_saving" OnClick="OnSave">@AppStrings.Save</MudLoadingButton>
        <MudButton OnClick="Cancel">@AppStrings.Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    MudForm _form = new();
    private bool _saving = false;
    private bool _savingnew = false;
    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; } = default!;
    [EditorRequired][Parameter] public SendAndPersistSmsCommand _model { get; set; } = null!;


    async Task OnSave()
    {
       try
        {
            _saving = true;
            await _form.ValidateAsync();
            if (!_form.IsValid)
                return;
            var result = await Mediator.Send(_model);
            result.Match(data =>
            {
                MudDialog.Close(DialogResult.Ok(true));
                Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
            }, errors =>
            {
                Snackbar.Add(errors, MudBlazor.Severity.Error);
            });
        }
        finally
        {
            _saving = false;
        }
    }
    async Task OnSaveAndNew()
    {
        try
        {
            _savingnew = true;
            await _form.ValidateAsync();
            if (!_form.IsValid)
                return;
            var result = await Mediator.Send(_model);
            result.Match(data =>
            { 
                Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);

                 Task.Delay(300);

                _model = new SendAndPersistSmsCommand() {To =_model.To,SimSlot = _model.SimSlot, Body=_model.Body};
            }, errors =>
            {
                Snackbar.Add(errors, MudBlazor.Severity.Error);
            });
        }
        finally
        {
            _savingnew = false;
        }

    }

    void Cancel() => MudDialog.Cancel();
}
