
@using CleanArchitecture.Blazor.Application.Features.SPackages.DTOs

@inherits MudComponentBase
@inject IStringLocalizer<SPackages> L



<MudDialog>
    <DialogContent>
        <MudForm _model="@_model">
            <MudGrid>
                <MudItem md="12">
                    <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x => x.SProvider)]" Value="_model.SProvider"></ReadOnlyField>
                </MudItem>
                <MudItem md="12">
                    <MudTextField ReadOnly=true Label="@L[_model.GetMemberDisplayName(x => x.Name)]" Value="_model.Name"></MudTextField>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@AppStrings.Close</MudButton>
    </DialogActions>
</MudDialog>
    @code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public SPackageDto _model { get; set; } = null!;
    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;

    }


    void Cancel() => MudDialog.Cancel();
}