@page "/pages/TrdBx/Tickets"
@using CleanArchitecture.Blazor.Application.Features.Tickets.Caching
@using CleanArchitecture.Blazor.Application.Features.Tickets.Commands.Accept
@using CleanArchitecture.Blazor.Application.Features.Tickets.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.Tickets.Commands.Reject
@using CleanArchitecture.Blazor.Application.Features.Tickets.Commands.UnReject
@using CleanArchitecture.Blazor.Application.Features.Tickets.DTOs
@using CleanArchitecture.Blazor.Application.Features.Tickets.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.Tickets.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.Tickets.Specifications
@using CleanArchitecture.Blazor.Domain.Enums
@using CleanArchitecture.Blazor.Server.UI.Pages.TrdBx.Tickets.Components




@inject IStringLocalizer<Tickets> L
@inject BlazorDownloadFileService BlazorDownloadFileService

@attribute [Authorize(Policy = Permissions.Tickets.View)]

<PageTitle>@Title</PageTitle>

<AdvancedSearchTickets TRequest="Query" OnConditionChanged="ConditionChanged"></AdvancedSearchTickets>

<MudDataGrid ServerData="@(ServerReload)"
             FixedHeader="true"
             FixedFooter="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             ColumnResizeMode="ResizeMode.Column"
             MultiSelection="true"
             T="TicketDto"
             SelectOnRowClick="false"
             RowClick="@(s=>OnView(s.Item))"
             @bind-SelectedItems="_selectedItems"
             Hover="true" @ref="_table">

@* ServerData="@(ServerReload)"
             FixedHeader="true"
             FixedFooter="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             ColumnResizeMode="ResizeMode.Column"
             MultiSelection="true"
             T="TicketDto"
             SelectOnRowClick="false"
             RowClick="@(s=>OnView(s.Item))"
             @bind-SelectedItems="_selectedItems"
             Hover="true" @ref="_table"> *@

    <ToolBarContent>
        <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Start">
                <MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudEnumSelect Style="min-width:120px" TEnum="TicketListView" ValueChanged="OnChangedListView" Value="Query.ListView" Dense="true" Label="@AppStrings.ListView">
                    </MudEnumSelect>
                </MudStack>
            </MudStack>
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudToolBar Dense WrapContent="true" Class="py-1 px-0">
                    <MudButton Disabled="@_loading"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @AppStrings.Refresh
                    </MudButton>

                    <MudMenu TransformOrigin="Origin.BottomRight" AnchorOrigin="Origin.BottomRight" EndIcon="@Icons.Material.Filled.MoreVert" Label="@AppStrings.More">

                        @if (_accessRights.Delete)
                        {
                            <MudMenuItem Disabled="@(!(_selectedItems.Count > 0))"
                                         OnClick="OnDeleteChecked">
                                @AppStrings.Delete
                            </MudMenuItem>
                        }
                        @if (_accessRights.Export)
                        {
                            <MudMenuItem Disabled="@_exporting"
                                         OnClick="OnExport">
                                @AppStrings.Export
                            </MudMenuItem>
                        }

                    </MudMenu>
                </MudToolBar>
                <MudStack Row Spacing="1">

        
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@Query.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
                        </MudTextField>

                </MudStack>
            </MudStack>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <SelectColumn ShowInFooter="false"></SelectColumn>
        <TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Actions" Sortable="false">
            <CellTemplate>
                @if (_accessRights.Delete)
                {
                    <MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Size="Size.Small"
                             Dense="true"
                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">

                        }
                        @if (_accessRights.Delete)
                        {
                            <MudMenuItem OnClick="@(()=>OnDelete(context.Item))">@AppStrings.Delete</MudMenuItem>
                        }
                    </MudMenu>
                }
                else
                {
                    <MudIconButton Variant="Variant.Filled"
                                   Disabled="true"
                                   Icon="@Icons.Material.Filled.DoNotTouch"
                                   Size="Size.Small"
                                   Color="Color.Surface">
                        @AppStrings.NoAllowed
                    </MudIconButton>
                }
            </CellTemplate>
        </TemplateColumn>

        <TemplateColumn HeaderStyle="width:60px" Sortable="false">
            <CellTemplate>
                @if (_accessRights.Delete)
                {
                    <MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Size="Size.Small"
                             Dense="true"
                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">

                       
                        @if (_accessRights.Accept)
                        {
                            <MudMenuItem Disabled="!(context.Item.TicketStatus == TicketStatus.Opened)" OnClick="@(() => OnAccept(context.Item))">"@L["Approve"]"</MudMenuItem>
                        }
                        @if (_accessRights.Reject)
                        {
                            <MudMenuItem Disabled="!(context.Item.TicketStatus == TicketStatus.Opened)" OnClick="@(() => OnReject(context.Item))">"@L["Reject"]"</MudMenuItem>
                        }
                        @if (_accessRights.UnReject)
                        {
                            <MudMenuItem Disabled="!(context.Item.TicketStatus == TicketStatus.Rejected)" OnClick="@(() => OnUnReject(context.Item))">"@L["UnReject"]"</MudMenuItem>
                        }
                    </MudMenu>
                }
                
                else
                {
                    <MudIconButton Variant="Variant.Filled"
                                   Disabled="true"
                                   Icon="@Icons.Material.Filled.DoNotTouch"
                                   Size="Size.Small"
                                   Color="Color.Surface">
                        @AppStrings.NoAllowed
                    </MudIconButton>
                }
            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.TicketNo" Title="@L[_currentDto.GetMemberDisplayName(x=>x.TicketNo)]" />
        <PropertyColumn Property="x => x.CreatedByUser.DisplayName" Title="@L[_currentDto.GetMemberDisplayName(x => x.CreatedByUser)]" />
        <PropertyColumn Property="x => x.ServiceTask" Title="@L[_currentDto.GetMemberDisplayName(x => x.ServiceTask)]" />
        <PropertyColumn Property="x => x.Description" Title="@L[_currentDto.GetMemberDisplayName(x=>x.Description)]" />
        <PropertyColumn Property="x => x.TicketStatus" Title="@L[_currentDto.GetMemberDisplayName(x=>x.TicketStatus)]" />
        <PropertyColumn Property="x => x.TcDate" Title="@L[_currentDto.GetMemberDisplayName(x=>x.TcDate)]" />
        @* <PropertyColumn Property="x => x.TrackingUnitId" Title="@L[_currentDto.GetMemberDisplayName(x=>x.TrackingUnitId)]" /> *@
        <PropertyColumn Property="x => x.TrackingUnit" Title="@L[_currentDto.GetMemberDisplayName(x => x.TrackingUnit)]" />
        <PropertyColumn Property="x => x.TaDate" Title="@L[_currentDto.GetMemberDisplayName(x=>x.TaDate)]" />
        <PropertyColumn Property="x => x.LastModifiedByUser.DisplayName" Title="@L[_currentDto.GetMemberDisplayName(x => x.LastModifiedByUser)]" />
        <PropertyColumn Property="x => x.TeDate" Title="@L[_currentDto.GetMemberDisplayName(x => x.TeDate)]" />

    </Columns>
    <NoRecordsContent>
        <MudText>@AppStrings.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@AppStrings.Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager PageSizeOptions="@(new int[]{10,15,30,50,100})" />
    </PagerContent>
</MudDataGrid>



@code {

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private UserProfile UserProfile => UserProfileState.Value;
    private TicketsAccessRights _accessRights = new ();
    public string? Title { get; private set; }
    private HashSet<TicketDto> _selectedItems = new();
    private MudDataGrid<TicketDto> _table = default!;
    private TicketDto _currentDto = new();
    // private TicketsAccessRights _accessRights = new();

    private MudList<TicketDto> _list = default!;
    private int _defaultPageSize = 15;
    private bool _loading;
    private bool _exporting;
    private bool _accepting;
    private bool _unrejecting;


    private TicketsWithPaginationQuery Query { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Title =L[_currentDto.GetClassDescription()];
        _accessRights = await PermissionService.GetAccessRightsAsync<TicketsAccessRights>();
    }

     private async Task<GridData<TicketDto>> ServerReload(GridState<TicketDto> state, CancellationToken cancellationToken)
    {
         try
        {
            _loading = true;
            Query.OrderBy = state.SortDefinitions.FirstOrDefault()?.SortBy ?? "Id";
            Query.SortDirection = state.SortDefinitions.FirstOrDefault()?.Descending ?? true
                                              ? SortDirection.Descending.ToString()
                                              : SortDirection.Ascending.ToString();
            Query.PageNumber = state.Page + 1;
            Query.PageSize = state.PageSize;
            var result = await Mediator.Send(Query).ConfigureAwait(false);
            return new GridData<TicketDto> { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }
    }

    private void ConditionChanged(string s)
    {
        InvokeAsync(_table.ReloadServerData);
    }

      private async Task OnRefresh()
    {
        await AppCache.RemoveByTagsAsync(TicketCacheKey.Tags);
        _selectedItems = new HashSet<TicketDto>();
        Query.Keyword  = string.Empty;
        await _table.ReloadServerData();
    }
    private async Task OnSearch(string text)
    {
        _selectedItems = new HashSet<TicketDto>();
        Query.Keyword = text;
        await _table.ReloadServerData();
    }

    private async Task OnChangedListView(TicketListView listview)
    {
        Query.ListView = listview;
        await _table.ReloadServerData();
    }


    #region Curd

    private Task OnDelete(TicketDto dto)
    {
        var contentText = string.Format(AppStrings.DeleteConfirmationWithId, dto.Id);
        var command = new DeleteTicketCommand(new int[] { dto.Id });
          return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
            command,
            AppStrings.DeleteConfirmationTitle,
            contentText,
            async () =>
            {
                 await _table.ReloadServerData();
                _selectedItems.Clear();
            });
    }

    private Task OnDeleteChecked()
    {

        var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedItems.Count);
        var command = new DeleteTicketCommand(_selectedItems.Select(x => x.Id).ToArray());
        return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
            command, 
            AppStrings.DeleteConfirmationTitle, 
            contentText, 
            async () =>
        {
            await InvokeAsync(async () =>
            {
                await _table.ReloadServerData();
                _selectedItems.Clear();
            });
        });
    }

   private async Task OnExport()
    {
        _exporting = true;
        try
		{
            var request = new ExportTicketsQuery()
                {
                    Keyword = Query.Keyword,
                    ListView = Query.ListView,
                    OrderBy = _table.SortDefinitions.Values.FirstOrDefault()?.SortBy ?? "Id",
                    SortDirection = (_table.SortDefinitions.Values.FirstOrDefault()?.Descending ?? true) ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString()
                };
            var result = await Mediator.Send(request);
            await result.MatchAsync(
            async data =>
            {
                await BlazorDownloadFileService.DownloadFileAsync($"{L["Tickets"]}.xlsx", data, contentType:"application/octet-stream");
                Snackbar.Add($"{AppStrings.ExportSuccess}", MudBlazor.Severity.Info);
            },
            errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        }
		catch (Exception ex)
		{
			Snackbar.Add($"Export failed: {ex.Message}", MudBlazor.Severity.Error);
		}
		finally
		{
			_exporting = false;
		}
    }

    #endregion




    private Task OnView(TicketDto dto)
    {
        Navigation.NavigateTo($"/pages/TrdBx/Tickets/{dto.Id}/view");
        return Task.CompletedTask;
    }




    private async Task OnAccept(TicketDto dto)
    {
        try
        {
            _accepting = true;
            var command = new AcceptTicketCommand() { Id = dto.Id };
            var result = await Mediator.Send(command);

            if (result.Succeeded)
            {
                Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
                await InvokeAsync(async () =>
                                               {
                                                   await _table.ReloadServerData();
                                                   _selectedItems.Clear();
                                               });
            }
            else
            {
                Snackbar.Add(result.ErrorMessage, MudBlazor.Severity.Error);
            }
        }
        finally
        {
            _accepting = false;
        }
    }
    private async Task OnReject(TicketDto dto)
    {

        var command = ObjectMapper.Map<RejectTicketCommand>(dto);
  
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        await DialogServiceHelper.ShowDialogAsync<RejectTicketDialog>(
            L["Reject Ticket"],
            async _ =>
            {
                await _table.ReloadServerData();
                _selectedItems = new();
            },
			p =>
			{
				p.Add(x => x._model, command);
			},
			options);

    }
    private async Task OnUnReject(TicketDto dto)
    {
       

        try
        {
            _unrejecting = true;
            var command = new UnRejectTicketCommand() { Id = dto.Id };
            var result = await Mediator.Send(command);

            if (result.Succeeded)
            {
                Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
                await InvokeAsync(async () =>
                                               {
                                                   await _table.ReloadServerData();
                                                   _selectedItems.Clear();
                                               });
            }
            else
            {
                Snackbar.Add(result.ErrorMessage, MudBlazor.Severity.Error);
            }
        }
        finally
        {
            _unrejecting = false;
        }
    }

  

}
