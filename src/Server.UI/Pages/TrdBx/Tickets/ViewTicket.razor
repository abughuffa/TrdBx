@using CleanArchitecture.Blazor.Application.Features.Tickets.DTOs
@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.DTOs
@using CleanArchitecture.Blazor.Application.Features.Tickets.Queries.GetById
@using CleanArchitecture.Blazor.Application.Features.Tickets.Commands.Execute
@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.Queries.GetById

@using CleanArchitecture.Blazor.Server.UI.Pages.TrdBx.Common.DailyTasks

@inherits MudComponentBase
@inject IStringLocalizer<Tickets> L
@attribute [Authorize(Policy = Permissions.Tickets.View)]

<PageTitle>@Title</PageTitle>

<MudContainer Class="mt-3" MaxWidth="MaxWidth.Medium">
    @if (_model != null)
    {
        <MudCard Class="pa-2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@Title</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid Spacing="2" Class="readonly-grid">
                    <MudItem md="4">
                        <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x=>x.TicketNo)]" Value="_model.TicketNo"></ReadOnlyField>
                    </MudItem>
                    <MudItem md="4">
                        <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x => x.TicketStatus)]" Value="_model.TicketStatus"></ReadOnlyField>
                    </MudItem>

                    <MudItem md="4">
                        <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x => x.TrackingUnit)]" Value="_model.TrackingUnit"></ReadOnlyField>
                    </MudItem>
                    <MudItem md="12">
                        <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x=>x.Description)]" Value="_model.Description"></ReadOnlyField>
                    </MudItem>
                    <MudItem md="12">
                        <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x=>x.Note)]" Value="_model.Note"></ReadOnlyField>
                    </MudItem>

                </MudGrid>
            </MudCardContent>
            <MudCardActions>
                
                <MudButton Color="Color.Primary" DropShadow="false" OnClick="OnGoBack">@AppStrings.GoBack</MudButton>
            </MudCardActions>
        </MudCard>
    }
    </MudContainer>


@code {

    public string? Title { get; private set; }
    [Parameter]
    public int Id { get; set; }

    private TicketDto? _model;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    bool _submitting;

    bool CanExecute = false;
    bool CanReject = false;





    protected override async Task OnInitializedAsync()
    {
        Title = L["Ticket"];

        var result = await Mediator.Send(new GetTicketByIdQuery() { Id = Id });

        result.Map(data =>
        {
            _model = data;
            return data;
        }).Match(data =>
        {
        }, errors =>
        {
            Snackbar.Add(errors, MudBlazor.Severity.Error);
        });
    }
    private Task OnGoBack()
    {
        Navigation.NavigateTo($"/pages/TrdBx/Tickets");
        return Task.CompletedTask;
    }
    private async Task OnExecute()
    {
      var result = await Mediator.Send(new GetTrackingUnitByIdQuery(){Id = _model.TrackingUnitId });
      try
        {
            switch (_model.ServiceTask)
            {
                case ServiceTask.Check:
                    {

                        await OnCheck(result.Data);
                        break;
                    }
                case ServiceTask.Install:
                case ServiceTask.ReInstall:
                    {
                        await OnInstall(result.Data);
                        break;
                    }

                case ServiceTask.Transfer:
                    {

                        await OnTransfer(result.Data);
                        break;
                    }

                case ServiceTask.Replace:
                    {

                        await OnReplace(result.Data); 
                        break;
                    }

                case ServiceTask.Recover:
                    {

                        await OnRecover(result.Data);
                        break;
                    }

                case ServiceTask.ActivateUnit:
                    {
                        await OnActivate(result.Data);

                        break;
                    }

                case ServiceTask.ActivateUnitForGprs:
                    {
                        await OnActivateGprs(result.Data);
                        break;
                    }

                case ServiceTask.ActivateUnitForHosting:
                    {
                        await OnActivateHosting(result.Data);
                        break;
                    }

                case ServiceTask.DeactivateUnit:
                    {
                        await OnDeactivate(result.Data);
                        break;
                    }

                case ServiceTask.RenewUnitSub:
                    {

                        await OnRenew(result.Data);
                        break;
                    }

                case ServiceTask.ReplacSimCard:
                    {

                        await OnReplaceSim(result.Data);
                        break;
                    }

                case ServiceTask.InstallSimCard:
                    {

                        await OnInstallSim(result.Data);
                        break;
                    }

                case ServiceTask.RecoverSimCard:
                    {

                        //Execute
                        break;
                    }
            }
        }
        finally
        {
            
        }
    }


    private async Task OnExecuted(int id)
    {
        await Mediator.Send(new MarkAsExecutedTicketCommand(){Id = id});
    }
    private async Task OnActivate(TrackingUnitDto dto)
    {
        //var command = ObjectMapper.Map<ActivateTrackingUnitCommand>(dto);
        var command = new ActivateTrackingUnitCommand(){Id = dto.Id};
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        await DialogServiceHelper.ShowDialogAsync<ActivateDialog>(
            string.Format(L["Activate TrackingUnit {0}"], dto.SNo),
            async _ =>
            {
              await OnExecuted(_model.Id);
            },
			p =>
			{
				p.Add(x => x._model, command);
                
			},
			options);
    }
