    private async Task OnExecuted(int id)
    {
         var result = await Mediator.Send(new MarkAsExecutedTicketCommand(){Id = id});

            if (result.Succeeded)
            {
                Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
                await InvokeAsync(async () =>
                                               {
                                                   Navigation.NavigateTo($"/pages/TrdBx/Tickets");
                                               });
            }
            else
            {
                Snackbar.Add(result.ErrorMessage, MudBlazor.Severity.Error);
            }
    }
