                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid Spacing="2" Class="readonly-grid">
                    <MudItem md="4">
                        <ReadOnlyFieldX6 Label="@L[model.GetMemberDescription(x=>x.TicketNo)]" Value="model.TicketNo"></ReadOnlyFieldX6>
                    </MudItem>
                    <MudItem md="4">
                        <ReadOnlyFieldX6 Label="@L[model.GetMemberDescription(x => x.TicketStatus)]" Value="model.TicketStatus"></ReadOnlyFieldX6>
                    </MudItem>
             @*        <MudItem md="4">
                        <ReadOnlyField Label="@L[model.GetMemberDescription(x => x.TrackingUnitId)]" Value="model.TrackingUnitId"></ReadOnlyField>
                    </MudItem> *@
                    <MudItem md="4">
                        <ReadOnlyFieldX6 Label="@L[model.GetMemberDescription(x => x.TrackingUnit)]" Value="model.TrackingUnit"></ReadOnlyFieldX6>
                    </MudItem>
                    <MudItem md="12">
                        <ReadOnlyFieldX12 Label="@L[model.GetMemberDescription(x=>x.Description)]" Value="model.Description"></ReadOnlyFieldX12>
                    </MudItem>
                    <MudItem md="12">
                        <ReadOnlyFieldX12 Label="@L[model.GetMemberDescription(x=>x.Note)]" Value="model.Note"></ReadOnlyFieldX12>
                    </MudItem>

                </MudGrid>
            </MudCardContent>
            <MudCardActions>
                
                <MudButton Color="Color.Primary" DropShadow="false" OnClick="OnGoBack">@ConstantString.GoBack</MudButton>
            </MudCardActions>
        </MudCard>
    }
    </MudContainer>


@code {

    public string? Title { get; private set; }
    [Parameter]
    public int Id { get; set; }

    private TicketDto? model;

    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    bool _submitting;

    bool CanExecute = false;
    bool CanReject = false;





    protected override async Task OnInitializedAsync()
    {
        Title = L["Ticket"];

        var result = await Mediator.Send(new GetTicketByIdQuery() { Id = Id });
        result.Map(data =>
{
    model = data;
    return data;
}).Match(data =>
{
    return data;

}, errors =>
{
    Snackbar.Add(errors, MudBlazor.Severity.Error);
    return null!;
});

    }


    private Task OnGoBack()
    {
        Navigation.NavigateTo($"/pages/TrdBx/Tickets");
        return Task.CompletedTask;
    }



    private async Task OnExecute()
    {
      var result = await Mediator.Send(new GetTrackingUnitByIdQuery(){Id = model.TrackingUnitId });
      try
        {
            switch (model.ServiceTask)
            {
                case ServiceTask.Check:
                    {

                        await OnCheck(result.Data);
                        break;
                    }
                case ServiceTask.Install:
                case ServiceTask.ReInstall:
                    {
                        await OnInstall(result.Data);
                        break;
                    }

                case ServiceTask.Transfer:
                    {

                        await OnTransfer(result.Data);
                        break;
                    }

                case ServiceTask.Replace:
                    {

                        await OnReplace(result.Data); 
                        break;
                    }

                case ServiceTask.Recover:
                    {

                        await OnRecover(result.Data);
                        break;
                    }

                case ServiceTask.ActivateUnit:
                    {
                        await OnActivate(result.Data);

                        break;
                    }

                case ServiceTask.ActivateUnitForGprs:
                    {
                        await OnActivateGprs(result.Data);
                        break;
                    }

                case ServiceTask.ActivateUnitForHosting:
                    {
                        await OnActivateHosting(result.Data);
                        break;
                    }

                case ServiceTask.DeactivateUnit:
                    {
                        await OnDeactivate(result.Data);
                        break;
                    }

                case ServiceTask.RenewUnitSub:
                    {

                        await OnRenew(result.Data);
                        break;
                    }

                case ServiceTask.ReplacSimCard:
                    {

                        await OnReplaceSim(result.Data);
                        break;
                    }

                case ServiceTask.InstallSimCard:
                    {

                        await OnInstallSim(result.Data);
                        break;
                    }

                case ServiceTask.RecoverSimCard:
                    {

                        //Execute
                        break;
                    }
            }
        }
        finally
        {
            
        }
    }


    private async Task OnExecuted(int id)
{
await Mediator.Send(new MarkAsExecutedTicketCommand(){Id = id});
}
    private Task OnActivate(TrackingUnitDto dto)
    {
        // var command = Mapper.Map<ActivateTrackingUnitCommand>(dto);
        var command = Mapper.ToActivateCommand(dto);
        // command.InstallerId = UserProfile.UserId;
        return DialogServiceHelper.ShowFormDialogWithContentTextAsync<ActivateDialog, ActivateTrackingUnitCommand>(
            string.Format(L["Activate TrackingUnit {0}"], dto.SNo),
            L["Select Activation date to activate tracking unit's subscription."],
            command,
            async () =>
            {
                await OnExecuted(model.Id);
              @*   await _table.ReloadServerData();
