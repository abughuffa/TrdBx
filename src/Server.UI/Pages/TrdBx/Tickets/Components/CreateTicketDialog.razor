
@using CleanArchitecture.Blazor.Application.Features.Tickets.Commands.Create
@using CleanArchitecture.Blazor.Domain.Enums
 
@inject IStringLocalizer<Tickets> L
@attribute [Authorize(Policy = Permissions.Tickets.Create)]

<MudDialog>
    <DialogContent>
        <MudForm Model="@_model" @ref="@_form" Validation="@(Validator.ValidateValue(_model))">
            <MudGrid>
                <MudItem md="12">
                    <MudText>@_contentText</MudText>
                </MudItem>

                <MudItem md="6">
                    <MudDatePicker Class="pa-4"
                                   Editable @bind-Date="_date"
                                   For="@(() => _date)"
                                   Required="true"
                                   RequiredError="@L["Date Is Required!"]" />
                </MudItem>

                <MudItem md="6">
                <MudSelect Style="min-width:120px"
                Placeholder="@L["Service Task"]"
                T="ServiceTask"
                Value="@_model.ServiceTask"
                ValueChanged="OnChangedServiceTask"
                Dense="true">
                @foreach (var task in GetFilteredServiceTasks())
                {
                    <MudSelectItem Value="task">
                        @task.GetDisplayName() <!-- Or use a display name if needed -->
                    </MudSelectItem>
                }
            </MudSelect>
                    @* <MudEnumSelect Style="min-width:120px" TEnum="ServiceTask" ValueChanged="OnChangedServiceTask" Value="_model.ServiceTask" Dense="true" Label="@L["Service Task"]">
                    </MudEnumSelect> *@
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions> 
        <MudLoadingButton Loading="@_saving" OnClick="OnSave">@AppStrings.Save</MudLoadingButton>
        <MudButton OnClick="Cancel">@AppStrings.Cancel</MudButton>
    </DialogActions>
</MudDialog>


@code
{

    private MudForm? _form;
    private bool _saving = false;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [EditorRequired][Parameter] public CreateTicketCommand _model { get; set; } = default!;
    [Parameter] public string? _contentText { get; set; } = default!;

    private IEnumerable<ServiceTask> GetFilteredServiceTasks()
    {
        // Define which enum values to exclude
        var excluded = new HashSet<ServiceTask> { 
            ServiceTask.TrdbxDataUpload,
            ServiceTask.StatusUpdate
        };

        // Return all enum values except the excluded ones
        return Enum.GetValues(typeof(ServiceTask))
                   .Cast<ServiceTask>()
                   .Where(x => !excluded.Contains(x))
                   .Select(x => (ServiceTask)x)
                   .ToList(); // Materialize to avoid re-evaluation on each render
    }
    private DateTime? _date
    {
        get => _model.TcDate.ToDateTime(TimeOnly.MinValue);
        set
        {
            if (value is not null)
            {
                _model.TcDate = DateOnly.FromDateTime((DateTime)value);
            }
        }
    }
    private Task OnChangedServiceTask(ServiceTask serviceTask)
    {
        _model.ServiceTask = serviceTask;
        return Task.CompletedTask;
    }



    async Task OnSave()
    {
        try
        {
            _saving = true;
             _form.ValidateAsync();
            if (!_form.IsValid)
                return;
            var result = await Mediator.Send(_model);
            result.Match(data =>
            {
                MudDialog.Close(DialogResult.Ok(true));
                Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
            }, errors =>
            {
                Snackbar.Add(errors, MudBlazor.Severity.Error);
            });
        }
        finally
        {
            _saving = false;
        }

    }

    void Cancel() => MudDialog.Cancel();



}