
@using CleanArchitecture.Blazor.Application.Features.TrackingUnitModels.DTOs

@inherits MudComponentBase
@inject IStringLocalizer<TrackingUnitModels> L


<MudDialog>
    <DialogContent>
        <MudForm Model="@_model">
            <MudGrid>
                <MudItem md="6">
                    <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x => x.Name)]" Value="_model.Name"></ReadOnlyField>
                </MudItem>
                <MudItem md="6">
                    <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x => x.WialonName)]" Value="_model.WialonName"></ReadOnlyField>
                </MudItem>
                <MudItem md="4">
                    <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x => x.WhwTypeId)]" Value="_model.WhwTypeId"></ReadOnlyField>
                </MudItem>
                <MudItem md="4">
                    <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x => x.PortNo1)]" Value="_model.PortNo1"></ReadOnlyField>
                </MudItem>
                <MudItem md="4">
                    <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x => x.PortNo2)]" Value="_model.PortNo2"></ReadOnlyField>
                </MudItem>
                <MudItem md="4">
                    <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x => x.DefualtGprs)]" Value="_model.DefualtGprs"></ReadOnlyField>
                </MudItem>
                <MudItem md="4">
                    <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x => x.DefualtHost)]" Value="_model.DefualtHost"></ReadOnlyField>
                </MudItem>
                <MudItem md="4">
                    <ReadOnlyField Label="@L[_model.GetMemberDisplayName(x => x.DefualtPrice)]" Value="_model.DefualtPrice"></ReadOnlyField>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@AppStrings.Close</MudButton>
    </DialogActions>
</MudDialog>


    @code {

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TrackingUnitModelDto _model { get; set; } = default!;

    void Cancel() => MudDialog.Cancel();
}