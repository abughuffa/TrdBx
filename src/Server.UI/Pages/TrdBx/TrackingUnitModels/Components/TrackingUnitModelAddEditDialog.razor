
@using CleanArchitecture.Blazor.Application.Features.TrackingUnitModels.Commands.AddEdit

@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<TrackingUnitModels> L
@attribute [Authorize(Policy = Permissions.TrackingUnitModels.Create)]
@attribute [Authorize(Policy = Permissions.TrackingUnitModels.Edit)]


<MudDialog>
    <DialogContent>
        <MudForm Model="@_command" @ref="@_form" Validation="@(Validator.ValidateValue(_command))">
            <MudGrid>
                <MudItem md="6">
                    <MudTextField Label="@L[_command.GetMemberDisplayName(x=>x.Name)]" @bind-Value="_command.Name" For="@(() => _command.Name)" Required="false" RequiredError="@L["Name is required!"]"></MudTextField>
                </MudItem>
                <MudItem md="6">
                    <MudTextField Label="@L[_command.GetMemberDisplayName(x => x.WialonName)]" @bind-Value="_command.WialonName" For="@(() => _command.WialonName)" Required="false" RequiredError="@L["Wialon Name is required!"]"></MudTextField>
                </MudItem>
                <MudItem md="4">
                    <MudTextField Label="@L[_command.GetMemberDisplayName(x => x.WhwTypeId)]" @bind-Value="_command.WhwTypeId" For="@(() => _command.WhwTypeId)" Required="false" RequiredError="@L["WhwTypeId is required!"]"></MudTextField>
                </MudItem>
                <MudItem md="4">
                    <MudTextField Label="@L[_command.GetMemberDisplayName(x => x.PortNo1)]" @bind-Value="_command.PortNo1" For="@(() => _command.PortNo1)" Required="false" RequiredError="@L["PortNo1 is required!"]"></MudTextField>
                </MudItem>
                <MudItem md="4">
                    <MudTextField Label="@L[_command.GetMemberDisplayName(x => x.PortNo2)]" @bind-Value="_command.PortNo2" For="@(() => _command.PortNo2)" Required="false" RequiredError="@L["PortNo2 is required!"]"></MudTextField>
                </MudItem>
                <MudItem md="4">
                    <MudTextField Label="@L[_command.GetMemberDisplayName(x=>x.DefualtGprs)]" @bind-Value="_command.DefualtGprs"></MudTextField>
                </MudItem>
                <MudItem md="4">
                    <MudTextField Label="@L[_command.GetMemberDisplayName(x=>x.DefualtHost)]" @bind-Value="_command.DefualtHost"></MudTextField>
                </MudItem>
                <MudItem md="4">
                    <MudTextField Label="@L[_command.GetMemberDisplayName(x=>x.DefualtPrice)]" @bind-Value="_command.DefualtPrice"></MudTextField>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>     
        <MudLoadingButton Loading="@_saving" OnClick="OnSubmit">@AppStrings.Save</MudLoadingButton>
        <MudButton OnClick="Cancel">@AppStrings.Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {

    
    private MudForm? _form;
    private bool _saving = false;
    public string? Title { get; private set; }

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [EditorRequired][Parameter] public AddEditTrackingUnitModelCommand _command { get; set; } = null!;



    async Task OnSubmit()
    {
        try
        {
            _saving = true;
            await _form.ValidateAsync();
            if (!_form.IsValid)
                return;
            var result = await Mediator.Send(_command);
            result.Match(data =>
            {
                MudDialog.Close(DialogResult.Ok(true));
                Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
            }, errors =>
            {
                Snackbar.Add(errors, MudBlazor.Severity.Error);
            });
        }
        finally
        {
            _saving = false;
        }
    }
    void Cancel() => MudDialog.Cancel();
}