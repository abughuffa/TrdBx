@page "/pages/TrdBx/MyData/Online/DataDiagnosises"


@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.DataDiagnosises.Caching
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.DataDiagnosises.DTOs
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.DataDiagnosises.Queries.Export
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.DataDiagnosises.Queries.Pagination
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.DataDiagnosises.Specifications
@using CleanArchitecture.Blazor.Server.UI.Pages.TrdBx.MyData.Online.Components

@inject IStringLocalizer<DataDiagnosises> L
@inject BlazorDownloadFileService BlazorDownloadFileService
@attribute [Authorize(Policy = Permissions.DataDiagnosises.View)]

<PageTitle>@Title</PageTitle>

<AdvancedSearchDiagnostics TRequest="Query" OnConditionChanged="ConditionChanged"></AdvancedSearchDiagnostics>

<MudDataGrid ServerData="@(ServerReload)"
             FixedHeader="true"
             FixedFooter="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             MultiSelection="true"
             @bind-SelectedItems="_selectedItems"
             ColumnResizeMode="ResizeMode.Column"
             Hover="true" @ref="_table"
             RowStyleFunc="@rowStyleFunc">
             
    <ToolBarContent>
        <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Start">
                <MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudEnumSelect Style="min-width:120px" TEnum="DataDiagnosisListView" ValueChanged="OnChangedListView" Value="Query.ListView" Dense="true" Label="@AppStrings.ListView">
                    </MudEnumSelect>
                </MudStack>
            </MudStack>
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudToolBar Dense WrapContent="true" Class="py-1 px-0">
                    <MudButton Disabled="@_loading"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @AppStrings.Refresh
                    </MudButton>
                    @if (_accessRights.Export)
                    {
                        <MudLoadingButton Disabled="@_exporting"
                                          Loading="_exporting"
                                          OnClick="@(() => OnExport())"
                                          StartIcon="@Icons.Custom.FileFormats.FileExcel">
                            @AppStrings.Export
                        </MudLoadingButton>
                    }
                </MudToolBar>
                <MudStack Row Spacing="1">
                  @*   @if (_accessRights.Search)
                    { *@
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@Query.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
                        </MudTextField>
                    @* } *@
                </MudStack>
            </MudStack>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <SelectColumn ShowInFooter="false"></SelectColumn>

        @*TODO: Define the fields that should be displayed in data table*@
        <PropertyColumn Property="x => x.UnitSNo" Title="@L[_currentDto.GetMemberDisplayName(x=>x.UnitSNo)]" />
        <PropertyColumn Property="x => x.SimCardNo" Title="@L[_currentDto.GetMemberDisplayName(x=>x.SimCardNo)]" />
        <PropertyColumn Property="x => x.StatusOnWialon" Title="@L[_currentDto.GetMemberDisplayName(x=>x.StatusOnWialon)]" Groupable="true" />
        <PropertyColumn Property="x => x.StatusOnTrdBx" Title="@L[_currentDto.GetMemberDisplayName(x=>x.StatusOnTrdBx)]" Groupable="true" />
        <PropertyColumn Property="x => x.SimCardStatus" Title="@L[_currentDto.GetMemberDisplayName(x=>x.SimCardStatus)]" Groupable="true" />
        <PropertyColumn Property="x => x.LDExDate" Title="@L[_currentDto.GetMemberDisplayName(x => x.LDExDate)]" Groupable="true" />
        <PropertyColumn Property="x => x.LDOExpired" Title="@L[_currentDto.GetMemberDisplayName(x=>x.LDOExpired)]" Groupable="true" />
        <PropertyColumn Property="x => x.Account" Title="@L[_currentDto.GetMemberDisplayName(x=>x.Account)]" Groupable="true" />
        <PropertyColumn Property="x => x.Client" Title="@L[_currentDto.GetMemberDisplayName(x=>x.Client)]" Groupable="true" />
        <PropertyColumn Property="x => x.Customer" Title="@L[_currentDto.GetMemberDisplayName(x=>x.Customer)]" Groupable="true" />
        <PropertyColumn Property="x => x.WNote" Title="@L[_currentDto.GetMemberDisplayName(x=>x.WNote)]" />
        <PropertyColumn Property="x => x.Balance" Title="@L[_currentDto.GetMemberDisplayName(x=>x.Balance)]" Sortable="false" />

    </Columns>
    <NoRecordsContent>
        <MudText>@AppStrings.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@AppStrings.Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager PageSizeOptions="@(new int[]{15,50,100,500,1000,1500,2000,2500})" />
    </PagerContent>
</MudDataGrid>



@code {

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private UserProfile UserProfile => UserProfileState.Value;
    private DataDiagnosisesAccessRights _accessRights = new();
    public string? Title { get; private set; }
    private HashSet<DataDiagnosisDto> _selectedItems = new();
    private MudDataGrid<DataDiagnosisDto> _table = default!;
    private DataDiagnosisDto _currentDto = new();
    // 
    private int _defaultPageSize = 15;
    private bool _loading;
    private bool _exporting;

    private DataDiagnosisesWithPaginationQuery Query { get; set; } = new();


    protected override async Task OnInitializedAsync()
    {
         Title = L[_currentDto.GetClassDescription()];
        _accessRights = await PermissionService.GetAccessRightsAsync<DataDiagnosisesAccessRights>();
    }
    private void ConditionChanged(string s)
    {
        InvokeAsync(_table.ReloadServerData);
    
    }
    private void IntConditionChanged(int s)
    {
        InvokeAsync(_table.ReloadServerData);
    }
    private Func<DataDiagnosisDto, int, string> rowStyleFunc => (x, i) =>
    {
        if ((x.StatusOnWialon == "Active" && x.StatusOnTrdBx == "Active")
         || (x.StatusOnWialon == "Active" && x.StatusOnTrdBx == "ActiveGprs")
         || (x.StatusOnWialon == "Inactive" && x.StatusOnTrdBx == "ActiveHosting"))
            return "background-color:#d6ffff";
        else if ((x.StatusOnWialon == "Active" && x.StatusOnTrdBx == "ActiveHosting")
         || (x.StatusOnWialon == "Active" && x.StatusOnTrdBx == "Inactive")
         || (x.StatusOnWialon == "Inactive" && x.StatusOnTrdBx == "Inactive"))
            return "background-color:#ffff8a";
        else if (x.StatusOnWialon == "Inactive" && x.StatusOnTrdBx == "Inactive")
            return "background-color:#FFD6FF";
        else
            return "background-color:#ffffff";
    };


    private async Task<GridData<DataDiagnosisDto>> ServerReload(GridState<DataDiagnosisDto> state, CancellationToken cancellationToken)
    {
        try
        {
            _loading = true;
            Query.OrderBy = state.SortDefinitions.FirstOrDefault()?.SortBy ?? "Id";
            Query.SortDirection = state.SortDefinitions.FirstOrDefault()?.Descending ?? true
                                              ? SortDirection.Descending.ToString()
                                              : SortDirection.Ascending.ToString();
            Query.PageNumber = state.Page + 1;
            Query.PageSize = state.PageSize;
            var result = await Mediator.Send(Query).ConfigureAwait(false);
            return new GridData<DataDiagnosisDto> { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }
    }

   private async Task OnRefresh()
    {
        await AppCache.RemoveByTagsAsync(DataDiagnosisCacheKey.Tags);
        _selectedItems = new HashSet<DataDiagnosisDto>();
        Query.Keyword  = string.Empty;
        await _table.ReloadServerData();
    }
    private async Task OnSearch(string text)
    {
        _selectedItems = new HashSet<DataDiagnosisDto>();
        Query.Keyword = text;
        await _table.ReloadServerData();
    }

    private async Task OnChangedListView(DataDiagnosisListView listview)
    {
        Query.ListView = listview;
        await _table.ReloadServerData();
    }

    private async Task OnExport()
    {
        _exporting = true;
        try
		{
            var request = new ExportDataDiagnosisesQuery()
                {
                     Keyword = Query.Keyword,
                ListView = Query.ListView,
                ExpiersBefore = Query.ExpiersBefore,
                StatusOnWialon = Query.StatusOnWialon,
                StatusOnTrdBx = Query.StatusOnTrdBx,
                SimCardStatus = Query.SimCardStatus,
                    OrderBy = _table.SortDefinitions.Values.FirstOrDefault()?.SortBy ?? "Id",
                    SortDirection = (_table.SortDefinitions.Values.FirstOrDefault()?.Descending ?? true) ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString()
                };
            var result = await Mediator.Send(request);
            await result.MatchAsync(
            async data =>
            {
                await BlazorDownloadFileService.DownloadFileAsync($"DataDiagnosises - {Query.ListView.ToString()}.xlsx", data, contentType:"application/octet-stream");
                Snackbar.Add($"{AppStrings.ExportSuccess}", MudBlazor.Severity.Info);
            },
            errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        }
		catch (Exception ex)
		{
			Snackbar.Add($"Export failed: {ex.Message}", MudBlazor.Severity.Error);
		}
		finally
		{
			_exporting = false;
		}
    }



}
