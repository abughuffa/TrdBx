@page "/pages/TrdBx/MyData/Online/WialonUnits/edit/{id:int}"


@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.WialonUnits.Commands.Update
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.WialonUnits.Queries.GetById



@inherits MudComponentBase
@inject IValidationService Validator
@inject IStringLocalizer<WialonUnits> L

<PageTitle>@Title</PageTitle>





<MudContainer Class="mt-3" MaxWidth="MaxWidth.Small">
    @if (model != null)
    {
        <MudCard Class="pa-2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">@Title</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>

                <MudForm Model="@model" @ref="@_form" Validation="@(Validator.ValidateValue(model))">
                    <MudGrid Spacing="2">
                        <MudItem md="12">
                            <MudTextField Label="@L[model.GetMemberDisplayName(x=>x.UnitSNo)]" @bind-Value="model.UnitSNo" For="@(() => model.UnitSNo)" Required="false" RequiredError="@L["UnitSNo is required!"]" />
                        </MudItem>
                        <MudItem md="6">
                            <MudTextField Label="@L[model.GetMemberDisplayName(x => x.SimCardNo)]" @bind-Value="model.SimCardNo" For="@(() => model.SimCardNo)" Required="false" RequiredError="@L["SimCardNo is required!"]" />
                        </MudItem>
                        <MudItem md="6">
                            <MudTextField Label="@L[model.GetMemberDisplayName(x=>x.StatusOnWialon)]" @bind-Value="model.StatusOnWialon" For="@(() => model.StatusOnWialon)"/>
                        </MudItem>
                        <MudItem md="12">
                            <MudTextField Label="@L[model.GetMemberDisplayName(x=>x.Note)]" @bind-Value="model.Note" For="@(() => model.Note)" />
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </MudCardContent>
            <MudCardActions Class="d-flex justify-end gap-2">
                <MudButton Color="Color.Primary" DropShadow="false" OnClick="Cancel">@AppStrings.Cancel</MudButton>
                <MudLoadingButton Color="Color.Primary" DropShadow="false" Loading="@_saving" OnClick="Save">@AppStrings.Save</MudLoadingButton>
            </MudCardActions>

        </MudCard>
    }
</MudContainer>

@code {

    public string? Title { get; private set; }
    [Parameter]
    public int Id { get; set; }
    MudForm? _form;
    private bool _saving = false;




    private UpdateWialonUnitCommand? model;



    protected override async  Task OnInitializedAsync()
    {

        Title = AppStrings.Edit;
    //     _breadcrumbItems = new List<BreadcrumbItem>
    // {
    //     new BreadcrumbItem("Home", href: "/"),
    //     new BreadcrumbItem("WialonUnits", href: "/pages/TrdBxDiagnose/WialonUnits")
    // };
        var result = await Mediator.Send(new GetWialonUnitByIdQuery() { Id = Id });

       result.Map(data =>
        {
            model = ObjectMapper.Map<UpdateWialonUnitCommand>(data);
            return model;
        }).Match(data =>
        {
        }, errors =>
        {
            Snackbar.Add(errors, MudBlazor.Severity.Error);
        });

    }
    async Task Save()
    {

         try
        {
            _saving = true;
            await _form.ValidateAsync();
            if (!_form.IsValid)
                return;
            var result = await Mediator.Send(model);
            result.Match(data =>
            {
                Navigation.NavigateTo($"/pages/TrdBx/MyData/Online/WialonUnits");
                Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
            }, errors =>
            {
                Snackbar.Add(errors, MudBlazor.Severity.Error);
            });
        }
        finally
        {
            _saving = false;
        }


    }

    async Task Cancel()
    {
        Navigation.NavigateTo($"/pages/TrdBx/MyData/Online/WialonUnits");

    }
}
