@page "/pages/TrdBx/MyData/Online/LibyanaSimCards"

@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.LibyanaSimCards.Caching
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.LibyanaSimCards.Commands.Delete
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.LibyanaSimCards.Commands.Import
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.LibyanaSimCards.Commands.Syncs
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.LibyanaSimCards.DTOs
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.LibyanaSimCards.Queries.Export
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.LibyanaSimCards.Queries.Pagination
@using CleanArchitecture.Blazor.Application.TrdBx.Features.MyData.Online.LibyanaSimCards.Specifications

@inject IStringLocalizer<LibyanaSimCards> L
    @inject BlazorDownloadFileService BlazorDownloadFileService
@attribute [Authorize(Policy = Permissions.LibyanaSimCards.View)]

<PageTitle>@Title</PageTitle>
<style>
    .mud-table-toolbar {
        height: 120px !important;
    }
</style>

<MudDataGrid ServerData="@(ServerReload)"
             FixedHeader="true"
             FixedFooter="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             MultiSelection="true"
             @bind-SelectedItems="_selectedItems"
             ColumnResizeMode="ResizeMode.Column"
             Hover="true" @ref="_table">

    <ToolBarContent>
        <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Start">
                <MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudEnumSelect Style="min-width:120px" TEnum="LibyanaSimCardListView" ValueChanged="OnChangedListView" Value="Query.ListView" Dense="true" Label="@AppStrings.ListView">
                    </MudEnumSelect>
                </MudStack>
            </MudStack>
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudToolBar Dense WrapContent="true" Class="py-1 px-0">
                    <MudButton Disabled="@_loading"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @AppStrings.Refresh
                    </MudButton>
                    @if (_accessRights.Import)
                    {
                            <MudFileUpload T="IBrowserFile" FilesChanged="OnImportData" Accept=".xlsx">
                                <CustomContent>
                                    <MudLoadingButton Class="pa-0 ma-0" Style="font-weight:400;text-transform:none;"
                                                      Variant="Variant.Text"
                                                      Loading="@_uploading"
                                                  StartIcon="@Icons.Custom.FileFormats.FileExcel">
                                    @AppStrings.Import
                                    </MudLoadingButton>
                                </CustomContent>
                            </MudFileUpload>
                    }
                    @if (_accessRights.Export)
                    {
                        <MudLoadingButton Disabled="@_exporting"
                                          Loading="_exporting"
                                          OnClick="@(() => OnExport())"
                                          StartIcon="@Icons.Custom.FileFormats.FileExcel">
                            @AppStrings.Export
                        </MudLoadingButton>
                    }
   

                    
                    @if (_accessRights.Delete)
                    {
                        <MudButton Disabled="@(!(_selectedItems.Count > 0))"
                                   OnClick="@(() => OnDeleteChecked())"
                                   IconColor="Color.Error"
                                   Variant="Variant.Text"
                                   Color="Color.Error"
                                   StartIcon="@Icons.Material.Outlined.Delete">

                            @AppStrings.Delete
                        </MudButton>
                    }
                </MudToolBar>
                <MudStack Row Spacing="1">
             @*        @if (_accessRights.Search)
                    { *@
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" 
                            Value="@Query.Keyword" Placeholder="@AppStrings.Search" 
                            Adornment="Adornment.End"
                            AdornmentIcon="@Icons.Material.Filled.Search" 
                            IconSize="Size.Small">
                        </MudTextField>
                    @* } *@
                </MudStack>
            </MudStack>
        </MudStack>
    </ToolBarContent>
             <Columns>
                <SelectColumn ShowInFooter="false"></SelectColumn>
                @*TODO: Define the fields that should be displayed in data table*@
                <PropertyColumn Property="x => x.SimCardNo" Title="@L[_currentDto.GetMemberDisplayName(x=>x.SimCardNo)]" />
        <PropertyColumn Property="x => x.SimCardStatus" Title="@L[_currentDto.GetMemberDisplayName(x=>x.SimCardStatus)]" Groupable="true" />
                <PropertyColumn Property="x => x.Balance" Title="@L[_currentDto.GetMemberDisplayName(x=>x.Balance)]" />
                <PropertyColumn Property="x => x.BExDate" Title="@L[_currentDto.GetMemberDisplayName(x=>x.BExDate)]" />
                <PropertyColumn Property="x => x.JoinDate" Title="@L[_currentDto.GetMemberDisplayName(x=>x.JoinDate)]" />
                <PropertyColumn Property="x => x.Package" Title="@L[_currentDto.GetMemberDisplayName(x=>x.Package)]" />
                <PropertyColumn Property="x => x.DExDate" Title="@L[_currentDto.GetMemberDisplayName(x=>x.DExDate)]" />
                <PropertyColumn Property="x => x.DataOffer" Title="@L[_currentDto.GetMemberDisplayName(x=>x.DataOffer)]" />
                <PropertyColumn Property="x => x.DOExpired" Title="@L[_currentDto.GetMemberDisplayName(x=>x.DOExpired)]" />
            </Columns>
    <NoRecordsContent>
        <MudText>@AppStrings.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@AppStrings.Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager PageSizeOptions="@(new int[]{15,50,100,500,1000,1500,2000,2500})" />
    </PagerContent>
</MudDataGrid>



@code {

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private UserProfile UserProfile => UserProfileState.Value;
    private LibyanaSimCardsAccessRights _accessRights = new();
    public string? Title { get; private set; }
    private HashSet<LibyanaSimCardDto> _selectedItems = new();
    private MudDataGrid<LibyanaSimCardDto> _table = default!;
    private LibyanaSimCardDto _currentDto = new();
    // 
    private int _defaultPageSize = 15;
    private bool _loading;
    private bool _uploading;
    private bool _exporting;




    private LibyanaSimCardsWithPaginationQuery Query { get; set; } = new();



 protected override async Task OnInitializedAsync()
    {
         Title = L[_currentDto.GetClassDescription()];
        _accessRights = await PermissionService.GetAccessRightsAsync<LibyanaSimCardsAccessRights>();
    }
    private async Task<GridData<LibyanaSimCardDto>> ServerReload(GridState<LibyanaSimCardDto> state, CancellationToken cancellationToken)
    {
        try
        {
            _loading = true;
            Query.OrderBy = state.SortDefinitions.FirstOrDefault()?.SortBy ?? "Id";
            Query.SortDirection = state.SortDefinitions.FirstOrDefault()?.Descending ?? true
                                              ? SortDirection.Descending.ToString()
                                              : SortDirection.Ascending.ToString();
            Query.PageNumber = state.Page + 1;
            Query.PageSize = state.PageSize;
            var result = await Mediator.Send(Query).ConfigureAwait(false);
            return new GridData<LibyanaSimCardDto> { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }
    }

   private async Task OnRefresh()
    {
        await AppCache.RemoveByTagsAsync(LibyanaSimCardCacheKey.Tags);
        _selectedItems = new HashSet<LibyanaSimCardDto>();
        Query.Keyword  = string.Empty;
        await _table.ReloadServerData();
    }
    private async Task OnSearch(string text)
    {
        _selectedItems = new HashSet<LibyanaSimCardDto>();
        Query.Keyword = text;
        await _table.ReloadServerData();
    }

    private async Task OnChangedListView(LibyanaSimCardListView listview)
    {
        Query.ListView = listview;
        await _table.ReloadServerData();
    }

@*     async Task UpdateLocalSimsExpairyDates()
    {
        try
        {
            _updateexpairy = true;
            var model = new SyncSimExpairyCommand();
            var result = await Mediator.Send(model);
