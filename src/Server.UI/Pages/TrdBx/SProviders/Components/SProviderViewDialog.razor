
@using CleanArchitecture.Blazor.Application.Features.SProviders.DTOs

@inherits MudComponentBase
@inject IStringLocalizer<SProviders> L



<MudDialog>
    <DialogContent>
        <MudForm Model="@model">
            <MudGrid>
                <MudItem md="12">
                    <MudTextField ReadOnly=true Label="@L[model.GetMemberDescription(x => x.Name)]" Value="model.Name"></MudTextField>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@ConstantString.Close</MudButton>
    </DialogActions>
</MudDialog>
    @code {

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public SProviderDto model { get; set; } = null!;
    protected override Task OnInitializedAsync()
    {

        return Task.CompletedTask;

    }


    void Cancel() => MudDialog.Cancel();
}