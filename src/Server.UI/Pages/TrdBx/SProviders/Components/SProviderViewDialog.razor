
@using CleanArchitecture.Blazor.Application.Features.SProviders.DTOs

@inherits MudComponentBase
@inject IStringLocalizer<SProviders> L



<MudDialog>
    <DialogContent>
        <MudForm Model="@_model">
            <MudGrid>
                <MudItem md="12">
                    <MudTextField ReadOnly=true Label="@L[_model.GetMemberDisplayName(x => x.Name)]" Value="_model.Name"></MudTextField>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@AppStrings.Close</MudButton>
    </DialogActions>
</MudDialog>
    @code {

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public SProviderDto _model { get; set; } = null!;
    protected override Task OnInitializedAsync()
    {

        return Task.CompletedTask;

    }


    void Cancel() => MudDialog.Cancel();
}