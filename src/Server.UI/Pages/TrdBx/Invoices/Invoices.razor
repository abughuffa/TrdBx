@page "/pages/TrdBx/Invoices"
@using CleanArchitecture.Blazor.Application.Features.Invoices.Commands.Create
@using CleanArchitecture.Blazor.Application.Features.Invoices.Commands.Update
@using CleanArchitecture.Blazor.Application.Features.Invoices.Commands.AddPayment
@using CleanArchitecture.Blazor.Application.Features.Invoices.Commands.SetPreviousStatus
@using CleanArchitecture.Blazor.Application.Features.Invoices.Commands.SetNextStatus
@using CleanArchitecture.Blazor.Application.Features.Invoices.Commands.SetAsCanceled
@using CleanArchitecture.Blazor.Application.Features.Invoices.Queries.Download
@using CleanArchitecture.Blazor.Application.Features.Invoices.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.Invoices.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.Invoices.Caching
@using CleanArchitecture.Blazor.Application.Features.Invoices.DTOs
@using CleanArchitecture.Blazor.Application.Features.Invoices.Specifications
@using CleanArchitecture.Blazor.Server.UI.Pages.TrdBx.Invoices.Components

@inject IStringLocalizer<Invoices> L
@inject BlazorDownloadFileService BlazorDownloadFileService

@attribute [Authorize(Policy = Permissions.Invoices.View)]

<PageTitle>@Title</PageTitle>

<AdvancedSearchInvoices TRequest="Query" OnFilterCriteriaChanged="FilterCriteriaChanged"></AdvancedSearchInvoices>

<MudDataGrid ServerData="@(ServerReload)"
             FixedHeader="true"
             FixedFooter="false"
             Virtualize="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             MultiSelection="true"
             T="InvoiceDto"
             SelectOnRowClick="false"
             RowClick="@(s=>OnView(s.Item))"
             @bind-SelectedItems="_selectedItems"
             Hover="true" @ref="_table">

    <ToolBarContent>
        <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">
            <MudStack Row AlignItems="AlignItems.Start">
                <MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudEnumSelect Style="min-width:120px" TEnum="InvoiceListView" ValueChanged="OnChangedListView" Value="Query.ListView" Dense="true" Label="@AppStrings.ListView">
                    </MudEnumSelect>
                </MudStack>
            </MudStack>
            <MudStack Spacing="0" AlignItems="AlignItems.End">
                <MudToolBar Dense WrapContent="true" Class="py-1 px-0">
                    <MudButton Disabled="@_loading"
                               OnClick="@(() => OnRefresh())"
                               StartIcon="@Icons.Material.Outlined.Refresh">
                        @AppStrings.Refresh
                    </MudButton>
                    @if (_accessRights.Create)
                    {
                        <MudButton StartIcon="@Icons.Material.Outlined.Add"
                        OnClick="OnCreate">
                            @AppStrings.New
                        </MudButton>
                    }
                    <MudMenu TransformOrigin="Origin.BottomRight" AnchorOrigin="Origin.BottomRight" EndIcon="@Icons.Material.Filled.MoreVert" Label="@AppStrings.More">
                        @if (_accessRights.Export)
                        {
                            <MudMenuItem Disabled="@_exporting"
                            OnClick="OnExport">
                                @AppStrings.Export
                            </MudMenuItem>
                        }
                    </MudMenu>
                </MudToolBar>
                <MudStack Row Spacing="1">
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@Query.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
                        AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
                        </MudTextField>
                </MudStack>
            </MudStack>
        </MudStack>
    </ToolBarContent>
    <Columns>
        <SelectColumn ShowInFooter="false"></SelectColumn>
        <TemplateColumn HeaderStyle="width:60px" Title="@AppStrings.Actions" Sortable="false">
            <CellTemplate>
                @if (_accessRights.ChangeStatus || _accessRights.Download || _accessRights.AddPayment)
                {
                    <MudMenu Icon="@Icons.Material.Filled.Edit" Variant="Variant.Filled" Size="Size.Small"
                    Dense="true"
                    EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
                        @if (_accessRights.Edit)
                        {
                            <MudMenuItem OnClick="@(() => OnEdit(context.Item))">@AppStrings.Edit</MudMenuItem>
                        }
                        @if (_accessRights.Download)
                        {
                            <MudMenuItem OnClick="@(() => OnDownLoad(context.Item))">@AppStrings.Download</MudMenuItem>
                        }
                        @if (_accessRights.AddPayment)
                        {
                            <MudMenuItem OnClick="@(() => OnAddPayment(context.Item))">@L["Pay"]</MudMenuItem>
                        }
                        @if (_accessRights.ChangeStatus)
                        {
                            <MudMenuItem OnClick="@(() => OnSetNextStatus(context.Item))">@L["Set Next Status"]</MudMenuItem>
                        }
                        @if (_accessRights.ChangeStatus)
                        {
                            <MudMenuItem OnClick="@(() => OnSetPreviousStatus(context.Item))">@L["Set Previous Status"]</MudMenuItem>
                        }

                    </MudMenu>
                }
                else
                {
                    <MudIconButton Variant="Variant.Filled"
                    Disabled="true"
                    Icon="@Icons.Material.Filled.DoNotTouch"
                    Size="Size.Small"
                    Color="Color.Surface">
                        @AppStrings.NoAllowed
                    </MudIconButton>
                }
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.InvoiceNo" Title="@L[_currentDto.GetMemberDisplayName(x=>x.InvoiceNo)]" />
        <PropertyColumn Property="x => x.IStatus" Title="@L[_currentDto.GetMemberDisplayName(x=>x.IStatus)]" />
        <PropertyColumn Property="x => x.InvoiceDate" Title="@L[_currentDto.GetMemberDisplayName(x=>x.InvoiceDate)]" />
        <PropertyColumn Property="x => x.DueDate" Title="@L[_currentDto.GetMemberDisplayName(x=>x.DueDate)]" />
        <PropertyColumn Property="x => x.DisplayCusName" Title="@L[_currentDto.GetMemberDisplayName(x => x.DisplayCusName)]" />
        <PropertyColumn Property="x => x.Description" Title="@L[_currentDto.GetMemberDisplayName(x=>x.Description)]" />
        <PropertyColumn Property="x => x.GrandTotal" Title="@L[_currentDto.GetMemberDisplayName(x=>x.GrandTotal)]" />
    </Columns>
    <NoRecordsContent>
        <MudText>@AppStrings.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@AppStrings.Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager PageSizeOptions="@(new int[]{10,15,30,50,100})" />
    </PagerContent>
</MudDataGrid>


@code 
{
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private UserProfile UserProfile => UserProfileState.Value;
    private InvoicesAccessRights _accessRights = new();
    public string? Title { get; private set; }
    private HashSet<InvoiceDto> _selectedItems = new();
    private MudDataGrid<InvoiceDto> _table = default!;
    private InvoiceDto _currentDto = new();
    private int _defaultPageSize = 15;
    private bool _loading;
    private bool _exporting;
    private bool _downloading;


    private InvoicesWithPaginationQuery Query { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Title =L[_currentDto.GetClassDescription()];
        _accessRights = await PermissionService.GetAccessRightsAsync<InvoicesAccessRights>();
    }
    private async Task<GridData<InvoiceDto>> ServerReload(GridState<InvoiceDto> state, CancellationToken cancellationToken)
    {
        try
        {
            _loading = true;
            Query.CurrentUser = UserProfile;
            Query.OrderBy = state.SortDefinitions.FirstOrDefault()?.SortBy ?? "Id";
            Query.SortDirection = state.SortDefinitions.FirstOrDefault()?.Descending ?? true
                                              ? SortDirection.Descending.ToString()
                                              : SortDirection.Ascending.ToString();
            Query.PageNumber = state.Page + 1;
            Query.PageSize = state.PageSize;
            var result = await Mediator.Send(Query).ConfigureAwait(false);
            return new GridData<InvoiceDto> { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }
    }


    private void FilterCriteriaChanged(string s)
    {
        InvokeAsync(_table.ReloadServerData);
    }

    private async Task OnRefresh()
    {
        await AppCache.RemoveByTagsAsync(InvoiceCacheKey.Tags);
        _selectedItems = new HashSet<InvoiceDto>();
        Query.Keyword  = string.Empty;
        Query.CurrentUser = UserProfile;
        await _table.ReloadServerData();
    }
    private async Task OnSearch(string text)
    {
        _selectedItems = new HashSet<InvoiceDto>();
        Query.Keyword = text;
        await _table.ReloadServerData();
    }

    private async Task OnChangedListView(InvoiceListView listview)
    {
        Query.ListView = listview;
        await _table.ReloadServerData();
    }


    private Task OnView(InvoiceDto dto)
    {
        Navigation.NavigateTo($"/pages/TrdBx/Invoices{dto.Id}/details");
        return Task.CompletedTask;
    }

    private Task OnEdit(InvoiceDto dto)
    {
   var command = ObjectMapper.Map<UpdateInvoiceCommand>(dto);
  
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        return DialogServiceHelper.ShowDialogAsync<InvoiceEditFormDialog>(
            L["Update Service Price"],
            async _ =>
            {
                await _table.ReloadServerData();
                 _selectedItems.Clear();
            },
			p =>
			{
				p.Add(x => x._model, command);
			},
			options);
    }

    private Task OnAddPayment(InvoiceDto dto)
    {

           // string.Format(L["Enter the amount of payment and Select Payment date. to be added to {0}"], dto.InvoiceNo),
  

            var command = new AddPaymentCommand() {Id = dto.Id };
  
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        return DialogServiceHelper.ShowDialogAsync<InvoiceAddPaymentFormDialog>(
            L["Add payment"],
            async _ =>
            {
                await _table.ReloadServerData();
                 _selectedItems.Clear();
            },
			p =>
			{
				p.Add(x => x._model, command);
			},
			options);
    }
    #region Curd

    private Task OnCreate()
    {
                 var command = new CreateInvoiceCommand();
  
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        return DialogServiceHelper.ShowDialogAsync<InvoiceCreateFormDialog>(
            L["Create SimCard"],
            async _ =>
            {
                await _table.ReloadServerData();
                 _selectedItems.Clear();
            },
			p =>
			{
				p.Add(x => x._model, command);
			},
			options);

    }





 private async Task OnExport()
    {
        _exporting = true;
        try
		{
            var request = new ExportInvoicesQuery()
                {
                    Keyword = Query.Keyword,
                       ListView = Query.ListView,
                        CustomerId = Query.CustomerId,
                        InvoiceType = Query.InvoiceType,
                        IStatus = Query.IStatus,                    OrderBy = _table.SortDefinitions.Values.FirstOrDefault()?.SortBy ?? "Id",
                    SortDirection = (_table.SortDefinitions.Values.FirstOrDefault()?.Descending ?? true) ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString()
                };
            var result = await Mediator.Send(request);
            await result.MatchAsync(
            async data =>
            {
                await BlazorDownloadFileService.DownloadFileAsync($"{L["Invoices"]}.xlsx", data, contentType:"application/octet-stream");
                Snackbar.Add($"{AppStrings.ExportSuccess}", MudBlazor.Severity.Info);
            },
            errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        }
		catch (Exception ex)
		{
			Snackbar.Add($"Export failed: {ex.Message}", MudBlazor.Severity.Error);
		}
		finally
		{
			_exporting = false;
		}
}

    #endregion



    private async Task OnSetNextStatus(InvoiceDto dto)
    {
            try
        {
            var result = await Mediator.Send(new SetNextStatusInvoiceCommand(dto.Id));
            
            if (result.Succeeded)
            {
                 await _table.ReloadServerData();
                _selectedItems.Clear();
                Snackbar.Add(L[$"{AppStrings.ExportSuccess}"], MudBlazor.Severity.Info); 
            }
            else
            {
                Snackbar.Add(result.ErrorMessage, MudBlazor.Severity.Error);
            }
        }
        finally
        {
           
        }
 
    }

    private async Task OnSetPreviousStatus(InvoiceDto dto)
    {

          try
        {
            var result = await Mediator.Send(new SetPreviousStatusInvoiceCommand(dto.Id));
            
            if (result.Succeeded)
            {
                 await _table.ReloadServerData();
                _selectedItems.Clear();
                Snackbar.Add(L[$"{AppStrings.ExportSuccess}"], MudBlazor.Severity.Info); 
            }
            else
            {
                Snackbar.Add(result.ErrorMessage, MudBlazor.Severity.Error);
            }
        }
        finally
        {
           
        }
 
    }


    private async Task OnSetAsCanceled(InvoiceDto dto)
    {

          try
        {
            var result = await Mediator.Send(new SetAsCanceledInvoiceCommand(dto.Id));
            
            if (result.Succeeded)
            {
                 await _table.ReloadServerData();
                _selectedItems.Clear();
                Snackbar.Add(L[$"{AppStrings.ExportSuccess}"], MudBlazor.Severity.Info); 
            }
            else
            {
                Snackbar.Add(result.ErrorMessage, MudBlazor.Severity.Error);
            }
        }
        finally
        {
           
        }
 
    }


    private async Task OnDownLoad(InvoiceDto dto)
    {

          try
        {
            _downloading = true;
            var result = await Mediator.Send(new DownloadInvoiceByIdQuery(dto.Id));
            
            if (result.Succeeded)
            {
                Snackbar.Add(L[$"{AppStrings.ExportSuccess}"], MudBlazor.Severity.Info); 
            }
            else
            {
                Snackbar.Add(result.ErrorMessage, MudBlazor.Severity.Error);
            }
        }
        finally
        {
            _downloading = false;
        }

    }


}
