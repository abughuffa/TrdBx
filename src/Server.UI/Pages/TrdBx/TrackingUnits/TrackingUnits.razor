@page "/pages/TrdBx/TrackingUnits"

@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.Caching
@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.Commands.Create
@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.Commands.Update
@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.Commands.DailyTasks.MarkTrackingUnitAsDamaged
@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.Commands.DailyTasks.MarkTrackingUnitAsUsed
@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.Commands.Delete
@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.Commands.Import
@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.DTOs
@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.Queries.Export
@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.Queries.Pagination
@using CleanArchitecture.Blazor.Application.Features.TrackingUnits.Specifications

@using CleanArchitecture.Blazor.Application.Features.Tickets.Commands.Create
@using CleanArchitecture.Blazor.Domain.Enums

@using CleanArchitecture.Blazor.Server.UI.Pages.TrdBx.TrackingUnits.Components
@using CleanArchitecture.Blazor.Server.UI.Pages.TrdBx.Tickets.Components


@inject IStringLocalizer<TrackingUnits> L
@inject BlazorDownloadFileService BlazorDownloadFileService
@attribute [Authorize(Policy = Permissions.TrackingUnits.View)]

<PageTitle>@Title</PageTitle>

<TrackingUnitsAdvancedFilter TRequest="Query" OnFilterCriteriaChanged="FilterCriteriaChanged"></TrackingUnitsAdvancedFilter>

<MudDataGrid ServerData="@(ServerReload)"
             FixedHeader="true"
             FixedFooter="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             ColumnResizeMode="ResizeMode.Column"
             MultiSelection="true"
             T="TrackingUnitDto"
             SelectOnRowClick="false"
             RowClick="@(s=>OnView(s.Item))"
             @bind-SelectedItems="_selectedItems"
             Hover="true" @ref="_table">

@* ServerData="@(ServerReload)"
             FixedHeader="true"
             FixedFooter="false"
             @bind-RowsPerPage="_defaultPageSize"
             Loading="@_loading"
             ColumnResizeMode="ResizeMode.Column"
             MultiSelection="true"
             T="TrackingUnitDto"
             SelectOnRowClick="false"
             RowClick="@(s=>OnView(s.Item))"
             @bind-SelectedItems="_selectedItems"
             Hover="true" @ref="_table"> *@

            <ToolBarContent>
                    <MudStack Row Spacing="0" Class="flex-grow-1" Justify="Justify.SpaceBetween">

                        <MudStack Row AlignItems="AlignItems.Start">
                            <MudIcon Icon="@Icons.Material.Filled.Window" Size="Size.Large" />
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.subtitle2" Class="mb-2">@Title</MudText>
                    <MudEnumSelect Style="min-width:120px" TEnum="TrackingUnitListView" ValueChanged="OnChangedListView" Value="Query.ListView" Dense="true" Label="@AppStrings.ListView">

                    </MudEnumSelect>
                            </MudStack>
                        </MudStack>

                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                            <MudToolBar Dense WrapContent="true" Class="py-1 px-0">

                                <MudButton Disabled="@_loading"
                                           OnClick="@(() => OnRefresh())"
                                           StartIcon="@Icons.Material.Outlined.Refresh">
                                    @AppStrings.Refresh
                                </MudButton>

                                 @if (_accessRights.Create)
                                     {
                                            <MudButton StartIcon="@Icons.Material.Outlined.Add"
                                                       OnClick="OnCreate">
                                                       @AppStrings.New
                                            </MudButton>
                                     }

                                 @if (tickets_accessRights.Create)
                                     {
                                             <MudButton Disabled="@(!(_selectedItems.Count > 0))"
                                                   OnClick="OnCreateTicketChecked">
                                                   @(L["Create Ticket"])
                                                   
                                             </MudButton>
                                     }

                                <MudMenu TransformOrigin="Origin.BottomRight" AnchorOrigin="Origin.BottomRight" EndIcon="@Icons.Material.Filled.MoreVert" Label="@AppStrings.More">
                        
                                        @if (_accessRights.Export)
                                                    {
                                                        <MudMenuItem Disabled="@_exporting"
                                                                     OnClick="OnExport">
                                                            @AppStrings.Export
                                                        </MudMenuItem>
                                                    }
                                        @if (_accessRights.Import)
                                                    {
                                                         <MudMenuItem>
                                                            <MudFileUpload T="IBrowserFile" FilesChanged="OnImportData" Accept=".xlsx">
                                                                <CustomContent>
                                                                    <MudButton Class="pa-0 ma-0" Style="font-weight:400;text-transform:none;"
                                                                            OnClick="@context.OpenFilePickerAsync"
                                                                            Variant="Variant.Text"
                                                                            Disabled="@_uploading">
                                                                        @AppStrings.Import
                                                                    </MudButton>
                                                                </CustomContent>
                                                                <SelectedTemplate></SelectedTemplate>
                                                            </MudFileUpload>
                                                        </MudMenuItem>
                                                    }
                                        @if (_accessRights.Delete)
                                        {
                                            <MudMenuItem Disabled="@(!(_selectedItems.Count > 0))"
                                                         OnClick="OnDeleteChecked">
                                                @AppStrings.Delete
                                            </MudMenuItem>
                                        }
                                </MudMenu>

                            </MudToolBar>

                            <MudStack Row Spacing="1">
                         @*         @if (_canSearch)
                                     { *@
                                            <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Value="@Query.Keyword" Placeholder="@AppStrings.Search" Adornment="Adornment.End"
                                                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small">
                                            </MudTextField>
                                     @* } *@

                            </MudStack>

                        </MudStack>

                    </MudStack>
                                    

            </ToolBarContent>
    <Columns>
        <SelectColumn ShowInFooter="false"></SelectColumn>

        <TemplateColumn Title="@AppStrings.Actions" HeaderStyle="width:80px" Sortable="false">
            <CellTemplate>
                
                <MudStack Spacing="2" Row="true" Justify="Justify.FlexStart">
                    <!-- Edit Menu -->
                    <MudMenu Icon="@Icons.Material.Filled.Edit"
                             Variant="Variant.Filled"
                             Size="Size.Small"
                             Dense="true"
                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                             IconColor="Color.Info"
                             AnchorOrigin="Origin.BottomLeft">
                        @if (_accessRights.Edit)
                        {
                            <MudMenuItem OnClick="@(()=>OnEdit(context.Item))">@AppStrings.Edit</MudMenuItem>
                        }
                        @if (_accessRights.ReassignOwner)
                        {
                            <MudMenuItem OnClick="@(() => OnReassignOwner(context.Item))"
                                         Disabled="(((context.Item.UStatus == UStatus.New) || (context.Item.UStatus == UStatus.Reserved)))">
                                @L["Reassign Owner"]

                            </MudMenuItem>
                        }
                        @if (_accessRights.Reserve)
                        {
                            <MudMenuItem OnClick="@(()=>OnReserve(context.Item))"
                                         Disabled="(!((context.Item.UStatus == UStatus.New) || (context.Item.UStatus == UStatus.Reserved)))">
                                @L["Reserve"]
                                
                            </MudMenuItem>
                        }
                        @if (_accessRights.MarkAsUsed)
                        {
                            <MudMenuItem OnClick="@(()=>OnMarkAsUsed(context.Item))"
                                         Disabled="(!((context.Item.UStatus == UStatus.Recovered) || (context.Item.UStatus == UStatus.Damaged)))">
                                @L["Mark as used"]
                            </MudMenuItem>
                        }
                        @if (_accessRights.MarkAsDamaged)
                        {
                            <MudMenuItem OnClick="@(()=>OnMarkAsDamaged(context.Item))"
                                         Disabled="(!((context.Item.UStatus == UStatus.Recovered) || (context.Item.UStatus == UStatus.Used)))">
                                @L["Mark as damaged"]
                            </MudMenuItem>
                        }
                        @if (_accessRights.MarkAsLost)
                        {
                            <MudMenuItem OnClick="@(()=>OnMarkAsLost(context.Item))"
                                         Disabled="(((context.Item.UStatus == UStatus.New) || (context.Item.UStatus == UStatus.Reserved)))">
                                @L["Mark as lost"]
                            </MudMenuItem>
                        }
                    </MudMenu>


                    <!-- Subscriptions Menu -->
                    <MudMenu Icon="@Icons.Material.Filled.AvTimer"
                             Variant="Variant.Filled"
                             Size="Size.Small"
                             Dense="true"
                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                             IconColor="Color.Info"
                             AnchorOrigin="Origin.CenterLeft">

                        <MudMenuItem OnClick="@(() => OnViewServiceLogs(context.Item))">
                            @L["View Services Logs"]

                        </MudMenuItem>

                        <MudMenuItem OnClick="@(()=>OnViewWialonTasks(context.Item))">
                            @L["View Wialon Tasks"]
                            </MudMenuItem>

                        <MudMenuItem OnClick="@(() => OnViewSubscriptions(context.Item))">
                            @L["View subscription periods"]
                        </MudMenuItem>



                    </MudMenu>
                    <!-- Services log Menu -->
                    <MudMenu Icon="@Icons.Material.Filled.Assignment"
                             Variant="Variant.Filled"
                             Size="Size.Small"
                             Dense="true"
                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                             IconColor="Color.Info"
                             AnchorOrigin="Origin.CenterLeft">

                        @if (tickets_accessRights.Create)
                        {
                            <MudButton OnClick="@(()=>OnCreateTicket(context.Item))">
                                @L["Create Ticket"]
                                
                            </MudButton>
                        }

            

                       


                    </MudMenu>
                </MudStack>

            </CellTemplate>
        </TemplateColumn>

        <PropertyColumn Property="x => x.SNo" Title="@L[_currentDto.GetMemberDisplayName(x=>x.SNo)]" />
        <PropertyColumn Property="x => x.SimCard" Title="@L[_currentDto.GetMemberDisplayName(x => x.SimCard)]" />
        @* <PropertyColumn Property="x => x.SNo" Title="@L["SNo"]" /> *@
        <PropertyColumn Property="x => x.UnitName" Title="@L[_currentDto.GetMemberDisplayName(x=>x.UnitName)]" />
        @* <PropertyColumn Property="x => x.TrackingUnitModelId" Title="@L[_currentDto.GetMemberDisplayName(x=>x.TrackingUnitModelId)]" /> *@
        <PropertyColumn Property="x => x.TrackingUnitModel" Title="@L[_currentDto.GetMemberDisplayName(x => x.TrackingUnitModel)]" />
        <PropertyColumn Property="x => x.UStatus" Title="@L[_currentDto.GetMemberDisplayName(x=>x.UStatus)]" />
        @* <PropertyColumn Property="x => x.CustomerId" Title="@L[_currentDto.GetMemberDisplayName(x=>x.CustomerId)]" /> *@
        <PropertyColumn Property="x => x.Customer" Title="@L[_currentDto.GetMemberDisplayName(x => x.Customer)]" Groupable="true" />
        @* <PropertyColumn Property="x => x.TrackedAssetId" Title="@L[_currentDto.GetMemberDisplayName(x => x.TrackedAssetId)]" /> *@
        <PropertyColumn Property="x => x.TrackedAsset" Title="@L[_currentDto.GetMemberDisplayName(x => x.TrackedAsset)]" />
        <PropertyColumn Property="x => x.InsMode" Title="@L[_currentDto.GetMemberDisplayName(x=>x.InsMode)]" />
        <PropertyColumn Property="x => x.WryDate" Title="@L[_currentDto.GetMemberDisplayName(x=>x.WryDate)]" />
        <PropertyColumn Property="x => x.IsOnWialon" Title="@L[_currentDto.GetMemberDisplayName(x=>x.IsOnWialon)]" />
        <PropertyColumn Property="x => x.WStatus" Title="@L[_currentDto.GetMemberDisplayName(x=>x.WStatus)]" />

        <TemplateColumn HeaderStyle="width:30px" Title="@AppStrings.Delete" Sortable="false">
            <CellTemplate>
                @if (_accessRights.Delete)
                {
                    <MudMenu Icon="@Icons.Material.Filled.Delete" Variant="Variant.Filled" Size="Size.Small"
                    Dense="true"
                    EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Info" AnchorOrigin="Origin.CenterLeft">
                        @if (_accessRights.Delete)
                        {
                            <MudMenuItem OnClick="@(()=>OnDelete(context.Item))">@AppStrings.Delete</MudMenuItem>
                        }
                    </MudMenu>
                }
                else
                {
                    <MudIconButton Variant="Variant.Filled"  
                    Disabled="true"
                    Icon="@Icons.Material.Filled.DoNotTouch"
                    Size="Size.Small"
                    Color="Color.Surface">
                        @AppStrings.NoAllowed
                    </MudIconButton>
                }
            </CellTemplate>
        </TemplateColumn>

    </Columns>
    <NoRecordsContent>
        <MudText>@AppStrings.NoRecords</MudText>
    </NoRecordsContent>
    <LoadingContent>
        <MudText>@AppStrings.Loading</MudText>
    </LoadingContent>
    <PagerContent>
        <MudDataGridPager PageSizeOptions="@(new int[]{10,15,30,50,100,500})" />
    </PagerContent>
</MudDataGrid>



@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private UserProfile UserProfile => UserProfileState.Value;
    private TrackingUnitsAccessRights _accessRights = new ();
    private TicketsAccessRights tickets_accessRights = new();
    [CascadingParameter]
    public string? Title { get; private set; }
    private HashSet<TrackingUnitDto> _selectedItems = new();
    private MudDataGrid<TrackingUnitDto> _table = default!;
    private TrackingUnitDto _currentDto = new();
    // private TrackingUnitsAccessRights _accessRights = new();
    private int _defaultPageSize = 15;
    private bool _loading;
    private bool _uploading;
    private bool _exporting;
    private TrackingUnitsWithPaginationQuery Query { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        Title =L[_currentDto.GetClassDescription()];
        _accessRights = await PermissionService.GetAccessRightsAsync<TrackingUnitsAccessRights>();
        tickets_accessRights = await PermissionService.GetAccessRightsAsync<TicketsAccessRights>();
    }



    private async Task<GridData<TrackingUnitDto>> ServerReload(GridState<TrackingUnitDto> state, CancellationToken cancellationToken)
    {
         try
        {
            _loading = true;
            Query.OrderBy = state.SortDefinitions.FirstOrDefault()?.SortBy ?? "Id";
            Query.SortDirection = state.SortDefinitions.FirstOrDefault()?.Descending ?? true
                                              ? SortDirection.Descending.ToString()
                                              : SortDirection.Ascending.ToString();
            Query.PageNumber = state.Page + 1;
            Query.PageSize = state.PageSize;
            var result = await Mediator.Send(Query).ConfigureAwait(false);
            return new GridData<TrackingUnitDto> { TotalItems = result.TotalItems, Items = result.Items };
        }
        finally
        {
            _loading = false;
        }

    }

    private void FilterCriteriaChanged(string? s)
    {
        InvokeAsync(_table.ReloadServerData);
    }

    private async Task OnRefresh()
    {
        await AppCache.RemoveByTagsAsync(TrackingUnitCacheKey.Tags);
        _selectedItems = new HashSet<TrackingUnitDto>();
        Query.Keyword  = string.Empty;
        await _table.ReloadServerData();
    }

    //**********
    private async Task OnSearch(string text)
    {
        _selectedItems = new HashSet<TrackingUnitDto>();
        Query.Keyword = text;
        await _table.ReloadServerData();
    }

    private async Task OnChangedListView(TrackingUnitListView listview)
    {
        Query.ListView = listview;
        await _table.ReloadServerData();
    }


    private void OnViewWialonTasks(TrackingUnitDto dto)
    {
        Navigation.NavigateTo($"/pages/TrdBx/WialonTasks/{dto.Id}/0?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
    }
    private void OnViewSubscriptions(TrackingUnitDto dto)
    {
        Navigation.NavigateTo($"/pages/TrdBx/Subscriptions/{dto.Id}/0?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
    }
    private void OnViewServiceLogs(TrackingUnitDto dto)
    {
        Navigation.NavigateTo($"/pages/TrdBx/TrackingUnits/{dto.Id}/ServiceLogs?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
    }



    async Task OnView(TrackingUnitDto dto)
    {
        // Navigation.NavigateTo($"/pages/TrdBx/TrackingUnits/{dto.Id}/view?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");

    }

#region Curd

    private Task OnCreate()
    {
        var command = new CreateTrackingUnitCommand();
  
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        return DialogServiceHelper.ShowDialogAsync<TrackingUnitCreateFormDialog>(
            L["Create TrackingUnit"],
            async _ =>
            {
                await _table.ReloadServerData();
                 _selectedItems.Clear();
            },
			p =>
			{
				p.Add(x => x._command, command);
			},
			options);
    }
    private Task OnEdit(TrackingUnitDto dto)
    {
        var command = ObjectMapper.Map<UpdateTrackingUnitCommand>(dto);
  
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        return DialogServiceHelper.ShowDialogAsync<TrackingUnitEditFormDialog>(
            L["Update TrackingUnit"],
            async _ =>
            {
                await _table.ReloadServerData();
                 _selectedItems.Clear();
            },
			p =>
			{
				p.Add(x => x._command, command);
			},
			options);
    }

    private Task OnDelete(TrackingUnitDto dto)
    {
        var contentText = string.Format(AppStrings.DeleteConfirmationWithId, dto.Id);
        var command = new DeleteTrackingUnitCommand(new int[] { dto.Id });
          return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
            command,
            AppStrings.DeleteConfirmationTitle,
            contentText,
            async () =>
            {
                 await _table.ReloadServerData();
                _selectedItems.Clear();
            });
    }

    private Task OnDeleteChecked()
    {

        var contentText = string.Format(AppStrings.DeleteConfirmWithSelected, _selectedItems.Count);
        var command = new DeleteTrackingUnitCommand(_selectedItems.Select(x => x.Id).ToArray());
        return DialogServiceHelper.ShowDeleteConfirmationDialogAsync(
            command, 
            AppStrings.DeleteConfirmationTitle, 
            contentText, 
            async () =>
        {
            await InvokeAsync(async () =>
            {
                await _table.ReloadServerData();
                _selectedItems.Clear();
            });
        });
    }


#endregion

    private Task OnCreateTicket(TrackingUnitDto dto)
    {
        var title = string.Format(L["Create Ticket for {0}"], dto.SNo);
        //var contentText = L["Select Service Task to create technical support ticket for the unit."];
        var command = new CreateTicketCommand(new int[] { dto.Id });
        return CreateTicketInternal(command, title);
    }

    private Task OnCreateTicketChecked()
    {
        var title = string.Format(L["Create Tickets"]);
        //var contentText = L["Select Service Task to create technical support ticket for the units."];
        var command = new CreateTicketCommand(_selectedItems.Select(x => x.Id).ToArray());
        return CreateTicketInternal(command, title);
    }

    private Task CreateTicketInternal(CreateTicketCommand command, string title)
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        return DialogServiceHelper.ShowDialogAsync<CreateTicketDialog>(
            title,
            async _ =>
            {
                 _selectedItems.Clear();
            },
			p =>
			{
				p.Add(x => x._model, command);
			},
			options);
    }

    @* private Task OnEdit(TrackingUnitDto dto)
    {
        var command = ObjectMapper.Map<UpdateTrackingUnitCommand>(dto);
  
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        return DialogServiceHelper.ShowDialogAsync<TrackingUnitEditFormDialog>(
            L["Update TrackingUnit"],
            async _ =>
            {
                await _table.ReloadServerData();
            },
			p =>
			{
				p.Add(x => x._command, command);
			},
			options);
    } *@

    private async Task OnMarkAsUsed(TrackingUnitDto dto)
    {
            var command = new MarkTrackingUnitAsUsedCommand() { Id = dto.Id };
            var result = await Mediator.Send(command);

            if (result.Succeeded)
            {
                Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
                await InvokeAsync(async () =>
                                               {
                                                   await _table.ReloadServerData();
                                                   _selectedItems.Clear();
                                               });
            }
            else
            {
                Snackbar.Add(result.ErrorMessage, MudBlazor.Severity.Error);
            }
    }

    private async Task OnMarkAsDamaged(TrackingUnitDto dto)
    {
        var command = new MarkTrackingUnitAsDamagedCommand() { Id = dto.Id };
        var result = await Mediator.Send(command);

        if (result.Succeeded)
        {
            Snackbar.Add(AppStrings.SaveSuccess, MudBlazor.Severity.Info);
            await InvokeAsync(async () =>
                                           {
                                               await _table.ReloadServerData();
                                               _selectedItems.Clear();
                                           });
        }
        else
        {
            Snackbar.Add(result.ErrorMessage, MudBlazor.Severity.Error);
        }
    }


    private Task OnMarkAsLost(TrackingUnitDto dto)
    {
        Navigation.NavigateTo($"/pages/TrdBx/TrackingUnits/{dto.Id}/MarkAsLost?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
        return Task.CompletedTask;
    }
    private Task OnReserve(TrackingUnitDto dto)
    {
        Navigation.NavigateTo($"/pages/TrdBx/TrackingUnits/Reserve/{dto.Id}");
        return Task.CompletedTask;
    } 
    private Task OnReassignOwner(TrackingUnitDto dto)
    {
        Navigation.NavigateTo($"/pages/TrdBx/TrackingUnits/ReassignOwner/{dto.Id}");
        return Task.CompletedTask;
    }
    private Task OnRecoverSim(TrackingUnitDto dto)
    {
        Navigation.NavigateTo($"/pages/TrdBx/TrackingUnits/RecoverSim/{dto.Id}");
        return Task.CompletedTask;
    }
    private async Task OnExport()
    {
        _exporting = true;
        try
		{
            var request = new ExportTrackingUnitsQuery()
                {
                    Keyword = Query.Keyword,
                    CustomerId = Query.CustomerId,
                    UStatus = Query.UStatus,
                    ListView = Query.ListView,
                    OrderBy = _table.SortDefinitions.Values.FirstOrDefault()?.SortBy ?? "Id",
                    SortDirection = (_table.SortDefinitions.Values.FirstOrDefault()?.Descending ?? true) ? SortDirection.Descending.ToString() : SortDirection.Ascending.ToString()
                };
            var result = await Mediator.Send(request);
            await result.MatchAsync(
            async data =>
            {
                await BlazorDownloadFileService.DownloadFileAsync($"{L["TrackingUnits"]}.xlsx", data, contentType:"application/octet-stream");
                Snackbar.Add($"{AppStrings.ExportSuccess}", MudBlazor.Severity.Info);
            },
            errors =>
            {
                Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                return Task.CompletedTask;
            });
        }
		catch (Exception ex)
		{
			Snackbar.Add($"Export failed: {ex.Message}", MudBlazor.Severity.Error);
		}
		finally
		{
			_exporting = false;
		}
    }
    private async Task OnImportData(IBrowserFile file)
    {
        _uploading = true;
        try
		{
           using var fileStream = file.OpenReadStream();
		   using var stream = new MemoryStream();
		   await fileStream.CopyToAsync(stream);
           var command = new ImportTrackingUnitsCommand(file.Name, stream.ToArray());
           var result = await Mediator.Send(command);
           await result.MatchAsync(
               async data =>
               {
                   await _table.ReloadServerData();
                   Snackbar.Add($"{AppStrings.ImportSuccess}", MudBlazor.Severity.Info);
               }, errors =>
               {
                   Snackbar.Add($"{errors}", MudBlazor.Severity.Error);
                   return Task.CompletedTask;
               });
        }
		catch (Exception ex)
		{
			Snackbar.Add($"Import failed: {ex.Message}", MudBlazor.Severity.Error);
		}
		finally
		{
			_uploading = false;
		}
    }

}
